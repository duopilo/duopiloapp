{
  // Headwind A330-900neo (MSFS 2024, Community-Paket headwindsim-aircraft-a330-900). Basiert auf FlyByWire – Grundlage ist das A32NX-Profil.
  // Bindings: "verified": true = in der Testsession am 28.10.2026 im Sim geprüft. Alles andere stammt aus dem A32NX-Profil und ist ungeprüft.
  // Fix A339 (29.10.2026): Variablen und Events gegen den Headwind-Quellcode (headwindsim/aircraft, hdw-a339x: A330_NEO_INTERIOR.xml,
  //   aircraft_preset_procedures.xml, Systems-WASM) und die FBW-Basis geprüft; Lesewerte im Reiseflug mit read_simvar gegengelesen.
  //
  // Bewusst NICHT übernommen (beim A330 anders oder nicht gefunden – ein unbekanntes L: liest 0 und würde Fehlalarme auslösen):
  //   athrMode (L:A32NX_AUTOTHRUST_MODE bleibt 0), ALT CRZ (fmgcDiscreteWord1), speedTarget, machMode, groundSpoilersOut, decelLight.
  // Unbrauchbar (generisch): BRAKE PARKING POSITION/INDICATOR, EXTERNAL POWER ON:1, AUTOPILOT MASTER, generischer Fuel Flow/EGT, AUTO BRAKE SWITCH CB.
  "name": "Headwind A330-900neo",
  "match": [
    { "path": [ "headwind", "a330" ] },
    { "path": [ "headwind_a330neo" ] },
    { "title": [ "A330-900neo" ] }
  ],
  "notes": "Based on FlyByWire. FCU values come from the older FBW variables (AUTOPILOT_SPEED_SELECTED, FCU_HEADING_SELECTED, ALTITUDE LOCK VAR:3). Thrust mode (THR CLB, SPEED) and ALT CRZ are still open. ECAM with the Headwind message table, electrics and fuel pumps in get_systems. Inputs as on the A32NX plus batteries and NAV & LOGO; FCU, lights, anti-ice, external power and APU tested in the sim, the rest unverified.",
  "bindings": {
    "ap1": { "name": "L:A32NX_AUTOPILOT_1_ACTIVE", "type": "bool", "verified": true },
    "ap2": { "name": "L:A32NX_AUTOPILOT_2_ACTIVE", "type": "bool", "verified": true },
    "athrStatus": {
      "name": "L:A32NX_AUTOTHRUST_STATUS", "type": "enum", "verified": true,
      "values": { "0": "OFF", "1": "ARMED", "2": "ACTIVE" }
    },
    "fmaLateral": {
      "name": "L:A32NX_FMA_LATERAL_MODE", "type": "enum", "verified": true,
      "values": {
        "0": "", "10": "HDG", "11": "TRK", "20": "NAV", "30": "LOC*", "31": "LOC", "32": "LAND", "33": "FLARE",
        "34": "ROLL OUT", "40": "RWY", "41": "RWY TRK", "50": "GA TRK"
      }
    },
    "fmaLateralArmed": {
      "name": "L:A32NX_FMA_LATERAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "NAV", "1": "LOC" }
    },
    "fmaVertical": {
      "name": "L:A32NX_FMA_VERTICAL_MODE", "type": "enum", "verified": true,
      "description": "ALT CRZ is not reported here (0) – still open",
      "values": {
        "0": "", "10": "ALT", "11": "ALT*", "12": "OP CLB", "13": "OP DES", "14": "V/S", "15": "FPA",
        "20": "ALT CST", "21": "ALT CST*", "22": "CLB", "23": "DES", "24": "FINAL", "30": "G/S*", "31": "G/S",
        "32": "LAND", "33": "FLARE", "34": "ROLL OUT", "40": "SRS", "41": "SRS GA", "50": "TCAS"
      }
    },
    "fmaVerticalArmed": {
      "name": "L:A32NX_FMA_VERTICAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "ALT", "1": "ALT CST", "2": "CLB", "3": "DES", "4": "G/S", "5": "FINAL", "6": "TCAS" }
    },
    "autobrake": {
      "name": "L:A32NX_AUTOBRAKES_ARMED_MODE", "type": "enum", "verified": true,
      "values": { "0": "OFF", "1": "LO", "2": "MED", "3": "MAX" }
    },
    "masterWarning": { "name": "L:A32NX_MASTER_WARNING", "type": "bool", "verified": true },
    "masterCaution": { "name": "L:A32NX_MASTER_CAUTION", "type": "bool", "verified": false, "description": "0 verified, triggering to 1 not yet" },
    "speedManaged": { "name": "L:A32NX_FCU_SPD_MANAGED_DOT", "type": "bool", "verified": true, "description": "Managed dot in the SPD window" },
    "selectedSpeed": { "name": "L:A32NX_AUTOPILOT_SPEED_SELECTED", "type": "number", "verified": true, "description": "Selected speed in kt, −1 when managed" },
    "selectedHeading": { "name": "L:A32NX_FCU_HEADING_SELECTED", "type": "number", "verified": true, "description": "Selected heading" },
    "selectedHeadingDashes": { "name": "L:A32NX_FCU_HDG_MANAGED_DASHES", "type": "bool", "verified": true, "description": "HDG window shows dashes (managed)" },
    "selectedAltitude": { "name": "AUTOPILOT ALTITUDE LOCK VAR:3", "unit": "feet", "type": "number", "verified": true, "description": "FCU altitude (index 3)" },
    "fuelFlowKgh": { "name": "L:A32NX_ENGINE_FF:{i}", "type": "number", "verified": false, "description": "Fuel flow per engine – returns values, unit probably kg/h" },
    "egtC": { "name": "L:A32NX_ENGINE_EGT:{i}", "type": "number", "verified": true, "description": "EGT per engine in °C" },
    "parkingBrake": { "name": "L:A32NX_PARK_BRAKE_LEVER_POS", "type": "bool", "verified": true },
    "apuMaster": { "name": "L:A32NX_OVHD_APU_MASTER_SW_PB_IS_ON", "type": "bool", "verified": true },
    "apuStart": { "name": "L:A32NX_OVHD_APU_START_PB_IS_ON", "type": "bool", "verified": true },
    "apuAvailable": { "name": "L:A32NX_OVHD_APU_START_PB_IS_AVAILABLE", "type": "bool", "verified": true },
    "apuN": { "name": "L:A32NX_APU_N", "type": "arinc429", "verified": true, "description": "APU N (%) from the ECB" },
    "apuBleed": { "name": "L:A32NX_OVHD_PNEU_APU_BLEED_PB_IS_ON", "type": "bool", "verified": false, "description": "APU BLEED pushbutton (from the A330 model; read 0 in flight with the APU off)" },
    "apuEgt": { "name": "L:A32NX_APU_EGT", "type": "arinc429", "verified": false, "description": "APU EGT (°C) from the ECB – in flight with the APU off only an invalid word (SSM 0)" },
    "apuFlapOpen": { "name": "L:A32NX_APU_FLAP_OPEN_PERCENTAGE", "unit": "percent", "type": "number", "verified": false, "description": "APU air intake flap open (%)" },
    "spoilersArmed": { "name": "L:A32NX_SPOILERS_ARMED", "type": "bool", "verified": false },
    "vls": { "name": "L:A32NX_SPEEDS_VLS", "type": "number", "verified": false },
    "v1": { "name": "L:AIRLINER_V1_SPEED", "unit": "knots", "type": "number", "verified": false },
    "vr": { "name": "L:AIRLINER_VR_SPEED", "unit": "knots", "type": "number", "verified": false },
    "v2": { "name": "L:AIRLINER_V2_SPEED", "unit": "knots", "type": "number", "verified": false },
    "tdReached": { "name": "L:A32NX_PFD_MSG_TD_REACHED", "type": "bool", "verified": false },
    "transAlt": { "name": "L:A32NX_FM1_TRANS_ALT", "type": "arinc429", "verified": false },
    "transLevel": { "name": "L:A32NX_FM1_TRANS_LVL", "type": "arinc429", "scale": 100, "verified": false },
    "decisionHeight": { "name": "L:A32NX_FM1_DECISION_HEIGHT", "type": "arinc429", "verified": false },
    "minimumDescentAltitude": { "name": "L:A32NX_FM1_MINIMUM_DESCENT_ALTITUDE", "type": "arinc429", "verified": false },
    "flaps": {
      "name": "L:A32NX_FLAPS_CONF_INDEX", "type": "enum", "verified": false,
      "values": { "0": "0", "1": "1", "2": "1+F", "3": "2", "4": "3", "5": "FULL" }
    }
  },
  "limits": {
    // A330-Werte (VFE je Stellung, VLO/VLE 250 kt) – für den -900neo bitte gegen das Headwind-Handbuch prüfen
    "vmoKt": 330,
    "vleKt": 250,
    "vloKt": 250,
    "vfeKt": { "1": 240, "1+F": 215, "2": 196, "3": 186, "FULL": 180 },
    "landingFlaps": [ "3", "FULL" ],
    "speedLimitBelowFl100Kt": 250,
    // Sicherheitssperren des Eingabe-Moduls (v0.9.1): Fahrwerk ausfahren nur unter 25 000 ft (A330-Limit),
    // Speedbrake nicht in CONF FULL (gegen das Headwind-/A330-FCOM prüfen), MSA aus der MORA im SimBrief-Navlog.
    "maxGearAltitudeFt": 25000,
    "speedbrakeInhibitFlaps": [ "FULL" ],
    "msaSource": "ofp"
  },
  // ECAM: Die Headwind-FWC (PseudoFWC.ts) schreibt dieselben EWD-Zeilen wie der A32NX. Im Flug gelesen: Memos 7001 IGNITION, 54001 PRED W/S OFF.
  // Tabelle aus dem Headwind-Repo (hdw-a339x/src/systems/shared/src/EwdMessages.ts) – wie die FBW-Tabelle plus A330-Codes.
  "ecam": {
    "format": "hdw-a339x",
    "leftLines": "L:A32NX_EWD_LOWER_LEFT_LINE_{n}",
    "rightLines": "L:A32NX_EWD_LOWER_RIGHT_LINE_{n}",
    "lines": 7
  },
  // Elektrik: Headwind nutzt das FBW-Elektriksystem (A32NX_ELEC_*). Im Flug gelesen: GEN 1 115 V, GEN 2 400 Hz, Last GEN 1 31 %, BAT 1 27 V,
  // AC BUS 1 und DC BAT BUS versorgt, APU GEN 0 V (APU aus). Der APU-GEN-Pushbutton ist die SimVar APU GENERATOR SWITCH:1 (Modell: FBW_Airbus_APU_Generator_Switch).
  "electrical": [
    { "key": "gen1Volt", "name": "L:A32NX_ELEC_ENG_GEN_1_POTENTIAL", "description": "GEN 1 (V)" },
    { "key": "gen1Hz", "name": "L:A32NX_ELEC_ENG_GEN_1_FREQUENCY", "description": "GEN 1 (Hz)" },
    { "key": "gen1Load", "name": "L:A32NX_ELEC_ENG_GEN_1_LOAD", "unit": "percent", "description": "GEN 1 load (%)" },
    { "key": "gen2Volt", "name": "L:A32NX_ELEC_ENG_GEN_2_POTENTIAL", "description": "GEN 2 (V)" },
    { "key": "gen2Hz", "name": "L:A32NX_ELEC_ENG_GEN_2_FREQUENCY", "description": "GEN 2 (Hz)" },
    { "key": "gen2Load", "name": "L:A32NX_ELEC_ENG_GEN_2_LOAD", "unit": "percent", "description": "GEN 2 load (%)" },
    { "key": "apuGenOn", "name": "APU GENERATOR SWITCH:1", "unit": "Bool", "description": "APU GEN Pushbutton", "values": { "0": "OFF", "1": "ON" } },
    { "key": "apuGenVolt", "name": "L:A32NX_ELEC_APU_GEN_1_POTENTIAL", "description": "APU GEN (V)" },
    { "key": "apuGenHz", "name": "L:A32NX_ELEC_APU_GEN_1_FREQUENCY", "description": "APU GEN (Hz)" },
    { "key": "apuGenLoad", "name": "L:A32NX_ELEC_APU_GEN_1_LOAD", "unit": "percent", "description": "APU GEN load (%)" },
    { "key": "extPwrVolt", "name": "L:A32NX_ELEC_EXT_PWR_POTENTIAL", "description": "EXT PWR (V)" },
    { "key": "bat1Volt", "name": "L:A32NX_ELEC_BAT_1_POTENTIAL", "description": "BAT 1 (V)" },
    { "key": "bat2Volt", "name": "L:A32NX_ELEC_BAT_2_POTENTIAL", "description": "BAT 2 (V)" },
    { "key": "ac1Powered", "name": "L:A32NX_ELEC_AC_1_BUS_IS_POWERED", "description": "AC BUS 1", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "ac2Powered", "name": "L:A32NX_ELEC_AC_2_BUS_IS_POWERED", "description": "AC BUS 2", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "acEssPowered", "name": "L:A32NX_ELEC_AC_ESS_BUS_IS_POWERED", "description": "AC ESS BUS", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dc1Powered", "name": "L:A32NX_ELEC_DC_1_BUS_IS_POWERED", "description": "DC BUS 1", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dc2Powered", "name": "L:A32NX_ELEC_DC_2_BUS_IS_POWERED", "description": "DC BUS 2", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dcEssPowered", "name": "L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED", "description": "DC ESS BUS", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dcBatPowered", "name": "L:A32NX_ELEC_DC_BAT_BUS_IS_POWERED", "description": "DC BAT BUS", "values": { "0": "unpowered", "1": "powered" } }
  ],
  // Treibstoffpumpen: keine L:-Variablen – das A330-Modell (FBW_Airbus_Fuel_Pump / FBW_Airbus_Fuel_Jet_Pump) nutzt die MSFS-Pumpen und -Ventile:
  // L TK 1 = Pumpe 2, L TK 2 = 5, R TK 1 = 3, R TK 2 = 6; CTR TK XFR L/R = Ventil 9/10, X FEED = Ventil 3. Im Flug gelesen: Pumpen 2 und 6 an und aktiv, Ventil 9 offen.
  "fuel": [
    { "key": "pumpL1", "name": "FUELSYSTEM PUMP SWITCH:2", "unit": "Enum", "description": "L TK PUMP 1", "values": { "0": "OFF", "1": "ON", "2": "AUTO" } },
    { "key": "pumpL2", "name": "FUELSYSTEM PUMP SWITCH:5", "unit": "Enum", "description": "L TK PUMP 2", "values": { "0": "OFF", "1": "ON", "2": "AUTO" } },
    { "key": "pumpR1", "name": "FUELSYSTEM PUMP SWITCH:3", "unit": "Enum", "description": "R TK PUMP 1", "values": { "0": "OFF", "1": "ON", "2": "AUTO" } },
    { "key": "pumpR2", "name": "FUELSYSTEM PUMP SWITCH:6", "unit": "Enum", "description": "R TK PUMP 2", "values": { "0": "OFF", "1": "ON", "2": "AUTO" } },
    { "key": "pumpL1Running", "name": "FUELSYSTEM PUMP ACTIVE:2", "unit": "Bool", "description": "L TK PUMP 1 running", "values": { "0": "no", "1": "yes" } },
    { "key": "pumpL2Running", "name": "FUELSYSTEM PUMP ACTIVE:5", "unit": "Bool", "description": "L TK PUMP 2 running", "values": { "0": "no", "1": "yes" } },
    { "key": "pumpR1Running", "name": "FUELSYSTEM PUMP ACTIVE:3", "unit": "Bool", "description": "R TK PUMP 1 running", "values": { "0": "no", "1": "yes" } },
    { "key": "pumpR2Running", "name": "FUELSYSTEM PUMP ACTIVE:6", "unit": "Bool", "description": "R TK PUMP 2 running", "values": { "0": "no", "1": "yes" } },
    { "key": "ctrXfrL", "name": "FUELSYSTEM VALVE SWITCH:9", "unit": "Bool", "description": "CTR TK XFR L", "values": { "0": "OFF", "1": "ON" } },
    { "key": "ctrXfrR", "name": "FUELSYSTEM VALVE SWITCH:10", "unit": "Bool", "description": "CTR TK XFR R", "values": { "0": "OFF", "1": "ON" } },
    { "key": "xfeedOpen", "name": "FUELSYSTEM VALVE OPEN:3", "unit": "Bool", "description": "X FEED valve", "values": { "0": "closed", "1": "open" } }
  ],
  "variables": [
    { "key": "bat1Auto", "name": "L:A32NX_OVHD_ELEC_BAT_1_PB_IS_AUTO", "description": "BAT 1", "values": { "0": "OFF", "1": "AUTO" } },
    { "key": "bat2Auto", "name": "L:A32NX_OVHD_ELEC_BAT_2_PB_IS_AUTO", "description": "BAT 2", "values": { "0": "OFF", "1": "AUTO" } },
    // GEN-Pushbutton: Das Modell (FBW_Airbus_Engine_Generator_Switch) nutzt GENERAL ENG MASTER ALTERNATOR – L:A32NX_OVHD_ELEC_ENG_GEN_1_PB_IS_ON las im Flug 0 bei laufendem GEN 1.
    { "key": "gen1On", "name": "GENERAL ENG MASTER ALTERNATOR:1", "unit": "Bool", "description": "GEN 1", "values": { "0": "OFF", "1": "ON" } },
    { "key": "gen2On", "name": "GENERAL ENG MASTER ALTERNATOR:2", "unit": "Bool", "description": "GEN 2", "values": { "0": "OFF", "1": "ON" } },
    { "key": "extPwrOn", "name": "L:A32NX_OVHD_ELEC_EXT_PWR_PB_IS_ON", "description": "EXT PWR", "values": { "0": "OFF", "1": "ON" } },
    { "key": "apuFault", "name": "L:A32NX_OVHD_APU_MASTER_SW_PB_HAS_FAULT", "description": "APU MASTER FAULT", "values": { "0": "–", "1": "FAULT" } },
    { "key": "adiru1State", "name": "L:A32NX_ADIRS_ADIRU_1_STATE", "description": "ADIRU 1", "values": { "0": "OFF", "1": "ALIGNING", "2": "ALIGNED" } }
  ],
  // Eingaben: 1:1 aus dem A32NX-Profil, dazu die eigenen A330-Fassungen von External Power und APU.
  // "verified": true = im Sim mit der A339 getestet (FCU, Lights, Anti-Ice, External Power, APU).
  // Angepasst für die A339 (noch ungeprüft): signs.seatbelts (3 Stellungen), signs.noSmoking (Enum), lights.landing (LIGHT LANDING:2),
  // fcu.headingManaged (Prüfung wartet länger). Alle übrigen Bereiche sind ungeprüft übernommen.
  "actions": [
    {
      "id": "fcu.speed",
      "area": "FCU",
      "label": "FCU speed",
      "description": "Sets the speed (kt) and pulls the knob (selected). In Mach mode it switches to knots first.",
      "parameter": { "min": 100, "max": 399, "step": 1, "unit": "kt" },
      "steps": [
        {
          "event": "A32NX.FCU_SPD_MACH_TOGGLE_PUSH",
          "skipIf": { "variable": "L:A32NX_FCU_AFS_DISPLAY_MACH_MODE", "equalTo": 0 },
          "delayMs": 150
        },
        {
          "event": "A32NX.FCU_SPD_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_SPD_PULL" }
      ],
      "readback": "Speed {value} selected",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_VALUE",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.speedManaged",
      "area": "FCU",
      "label": "Managed speed",
      "steps": [
        { "event": "A32NX.FCU_SPD_PUSH" }
      ],
      "readback": "Managed speed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_MANAGED", "expect": 1 },
      "verified": true
    },
    {
      "id": "fcu.heading",
      "area": "FCU",
      "label": "FCU heading",
      "parameter": { "min": 0, "max": 360, "step": 1, "unit": "°", "format": "heading" },
      "steps": [
        {
          "event": "A32NX.FCU_HDG_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_HDG_PULL" }
      ],
      "readback": "Heading {value} selected",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_VALUE", "expect": "{value}", "modulo": 360 },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "messageKey": "profile.requires.trkFpaMode" }
      ],
      "verified": true
    },
    {
      "id": "fcu.headingManaged",
      "area": "FCU",
      "label": "Managed NAV",
      "steps": [
        { "event": "A32NX.FCU_HDG_PUSH" }
      ],
      "readback": "Heading managed",
      "description": "Pushes the HDG knob. NAV takes a few seconds on the A330 – so the check waits up to 10 s.",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_MANAGED", "expect": 1, "timeoutMs": 10000 },
      "verified": false
    },
    {
      "id": "fcu.altitude",
      "area": "FCU",
      "label": "FCU altitude",
      "description": "Only sets the FCU altitude – to climb or descend, follow with fcu.altitudePull or fcu.altitudePush.",
      "parameter": { "min": 100, "max": 49000, "step": 100, "unit": "ft", "format": "altitude" },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude {value} set",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_ALT_VALUE",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.altitudePull",
      "area": "FCU",
      "label": "Altitude pull",
      "steps": [
        { "event": "A32NX.FCU_ALT_PULL" }
      ],
      "readback": "Altitude pull, open climb or descent",
      "verified": true
    },
    {
      "id": "fcu.altitudePush",
      "area": "FCU",
      "label": "Altitude push",
      "steps": [
        { "event": "A32NX.FCU_ALT_PUSH" }
      ],
      "readback": "Altitude push, managed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_LVL_CH_MANAGED", "expect": 1 },
      "verified": true
    },
    {
      "id": "fcu.altIncrement",
      "area": "FCU",
      "label": "Altitude increment",
      "parameter": {
        "type": "choice",
        "options": { "100": 100, "1000": 1000 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_INCREMENT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude increment {value}",
      "check": {
        "variable": "L:A32NX_FCU_ALT_INCREMENT_1000",
        "expect": { "100": 0, "1000": 1 }
      },
      "verified": true
    },
    {
      "id": "fcu.vs",
      "area": "FCU",
      "label": "Vertical speed",
      "parameter": { "min": -6000, "max": 6000, "step": 100, "unit": "ft/min" },
      "steps": [
        {
          "event": "A32NX.FCU_VS_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_VS_PULL" }
      ],
      "readback": "Vertical speed {value}",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_VS_FPA_VALUE",
        "expect": "{value}",
        "tolerance": 50
      },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "messageKey": "profile.requires.trkFpaMode" }
      ],
      "verified": true
    },
    {
      "id": "fcu.loc",
      "area": "FCU",
      "label": "LOC",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
