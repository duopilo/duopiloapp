{
  // FlyByWire A32NX (MSFS 2024). Variablennamen aus der FBW-Doku (fbw-a32nx/docs/a320-simvars.md) und dem FBW-PFD-Code.
  // "verified": true = im Sim gegen das Cockpit geprüft (Testflüge 28.10.2026), false = laut Doku/Code, noch nicht geprüft.
  //
  // Einheiten: FBW speichert Geschwindigkeiten wie V1/VR/V2 und die Managed Speed intern in m/s und liest sie mit der Einheit
  // "knots" – deshalb "unit": "knots". Mit "number" kämen m/s heraus (z. B. 69 statt 134 kt).
  "name": "FlyByWire A32NX",
  "match": [
    { "path": [ "FlyByWire", "A320" ] },
    { "title": [ "A320neo", "FlyByWire" ] },
    { "title": [ "A32NX" ] }
  ],
  "notes": "AUTOPILOT MASTER, BRAKE PARKING POSITION, SPOILERS ARMED and ENG EXHAUST GAS TEMPERATURE are wrong on the A32NX – the values come from the A32NX variables. Engine fire can't be triggered via flyPad failures and has no variable of its own; a fire would show up as an ECAM message.",
  "bindings": {
    "ap1": { "name": "L:A32NX_AUTOPILOT_1_ACTIVE", "type": "bool", "verified": true },
    "ap2": { "name": "L:A32NX_AUTOPILOT_2_ACTIVE", "type": "bool", "verified": true },
    "athrStatus": {
      "name": "L:A32NX_AUTOTHRUST_STATUS", "type": "enum", "verified": false,
      "values": { "0": "OFF", "1": "ARMED", "2": "ACTIVE" }
    },
    "athrMode": {
      "name": "L:A32NX_AUTOTHRUST_MODE", "type": "enum", "verified": true,
      "values": {
        "0": "", "1": "MAN TOGA", "3": "MAN FLX", "5": "MAN MCT", "6": "MAN THR", "7": "SPEED", "8": "MACH",
        "9": "THR MCT", "10": "THR CLB", "11": "THR LVR", "12": "THR IDLE", "13": "A.FLOOR", "14": "TOGA LK"
      }
    },
    "fmaLateral": {
      "name": "L:A32NX_FMA_LATERAL_MODE", "type": "enum", "verified": true,
      "values": {
        "0": "", "10": "HDG", "11": "TRK", "20": "NAV", "30": "LOC*", "31": "LOC", "32": "LAND", "33": "FLARE",
        "34": "ROLL OUT", "40": "RWY", "41": "RWY TRK", "50": "GA TRK"
      }
    },
    "fmaLateralArmed": {
      "name": "L:A32NX_FMA_LATERAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "NAV", "1": "LOC" }
    },
    "fmaVertical": {
      "name": "L:A32NX_FMA_VERTICAL_MODE", "type": "enum", "verified": true,
      "description": "ALT CRZ is missing from this variable – Duopilo derives it from fmgcDiscreteWord1",
      "values": {
        "0": "", "10": "ALT", "11": "ALT*", "12": "OP CLB", "13": "OP DES", "14": "V/S", "15": "FPA",
        "20": "ALT CST", "21": "ALT CST*", "22": "CLB", "23": "DES", "24": "FINAL", "30": "G/S*", "31": "G/S",
        "32": "LAND", "33": "FLARE", "34": "ROLL OUT", "40": "SRS", "41": "SRS GA", "50": "TCAS"
      }
    },
    "fmaVerticalArmed": {
      "name": "L:A32NX_FMA_VERTICAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "ALT", "1": "ALT CST", "2": "CLB", "3": "DES", "4": "G/S", "5": "FINAL", "6": "TCAS" }
    },
    "fmgcDiscreteWord1": { "name": "L:A32NX_FMGC_1_DISCRETE_WORD_1", "type": "arinc429", "verified": false, "description": "FMGC 1 Discrete Word 1 (for ALT CRZ)" },
    "fmAltitudeConstraint": { "name": "L:A32NX_FMGC_1_FM_ALTITUDE_CONSTRAINT", "type": "arinc429", "verified": false, "description": "Next altitude constraint (ft)" },
    "autobrake": {
      "name": "L:A32NX_AUTOBRAKES_ARMED_MODE", "type": "enum", "verified": true,
      "values": { "0": "OFF", "1": "LO", "2": "MED", "3": "MAX" }
    },
    "masterWarning": { "name": "L:A32NX_MASTER_WARNING", "type": "bool", "verified": true },
    "masterCaution": { "name": "L:A32NX_MASTER_CAUTION", "type": "bool", "verified": true },
    "speedTarget": { "name": "L:A32NX_SPEEDS_MANAGED_PFD", "unit": "knots", "type": "number", "verified": false, "description": "FMS managed speed (stored in m/s, read in kt), 0 = invalid" },
    "speedManaged": { "name": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_MANAGED", "type": "bool", "verified": true, "description": "Managed dot in the SPD window" },
    "selectedSpeed": { "name": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_VALUE", "type": "number", "verified": true, "description": "SPD/MACH window value (kt or Mach)" },
    "machMode": { "name": "L:A32NX_FCU_AFS_DISPLAY_MACH_MODE", "type": "bool", "verified": false },
    "selectedAltitude": { "name": "L:A32NX_FCU_AFS_DISPLAY_ALT_VALUE", "type": "number", "verified": true, "description": "ALT window value (ft)" },
    "selectedHeading": { "name": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_VALUE", "type": "number", "verified": false, "description": "HDG/TRK window value" },
    "selectedHeadingDashes": { "name": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_DASHES", "type": "bool", "verified": false, "description": "HDG window shows dashes (managed)" },
    "vls": { "name": "L:A32NX_SPEEDS_VLS", "type": "number", "verified": true },
    "v1": { "name": "L:AIRLINER_V1_SPEED", "unit": "knots", "type": "number", "verified": false, "description": "V1 from the MCDU (stored in m/s)" },
    "vr": { "name": "L:AIRLINER_VR_SPEED", "unit": "knots", "type": "number", "verified": false },
    "v2": { "name": "L:AIRLINER_V2_SPEED", "unit": "knots", "type": "number", "verified": false },
    "flexTemp": { "name": "L:A32NX_AIRLINER_TO_FLEX_TEMP", "type": "number", "verified": false, "description": "FLEX temperature (°C) from the MCDU" },
    "tdReached": { "name": "L:A32NX_PFD_MSG_TD_REACHED", "type": "bool", "verified": false, "description": "PFD message T/D REACHED" },
    "fmsToWptDistance": { "name": "L:A32NX_EFIS_L_TO_WPT_DISTANCE", "type": "number", "verified": false, "description": "Distance to the active FMS waypoint (nm)" },
    "fmsToWptBearing": { "name": "L:A32NX_EFIS_L_TO_WPT_BEARING", "type": "number", "verified": false, "description": "Bearing to the active FMS waypoint (°)" },
    "fuelFlowKgh": { "name": "L:A32NX_ENGINE_FF:{i}", "type": "number", "verified": true, "description": "Fuel flow per engine in kg/h" },
    "egtC": { "name": "L:A32NX_ENGINE_EGT:{i}", "type": "number", "verified": false, "description": "EGT per engine in °C" },
    "parkingBrake": { "name": "L:A32NX_PARK_BRAKE_LEVER_POS", "type": "bool", "verified": false },
    "spoilersArmed": { "name": "L:A32NX_SPOILERS_ARMED", "type": "bool", "verified": true, "description": "Ground spoilers armed (lever)" },
    "groundSpoilersOut": { "name": "L:A32NX_SEC_1_GROUND_SPOILER_OUT", "type": "bool", "verified": false, "description": "Ground spoilers extended (SEC 1)" },
    "decelLight": { "name": "L:A32NX_AUTOBRAKES_DECEL_LIGHT", "type": "bool", "verified": false, "description": "Autobrake DECEL" },
    "transAlt": { "name": "L:A32NX_FM1_TRANS_ALT", "type": "arinc429", "verified": false, "description": "Transition altitude at departure (ft)" },
    "transLevel": { "name": "L:A32NX_FM1_TRANS_LVL", "type": "arinc429", "scale": 100, "verified": false, "description": "Transition level at destination (FL → ft)" },
    "decisionHeight": { "name": "L:A32NX_FM1_DECISION_HEIGHT", "type": "arinc429", "verified": false, "description": "DH from PERF APPR (ft), −1 = none" },
    "minimumDescentAltitude": { "name": "L:A32NX_FM1_MINIMUM_DESCENT_ALTITUDE", "type": "arinc429", "verified": false, "description": "MDA from PERF APPR (ft)" },
    "apuMaster": { "name": "L:A32NX_OVHD_APU_MASTER_SW_PB_IS_ON", "type": "bool", "verified": false, "description": "APU MASTER SW (same variable as the apu.master input)" },
    "apuStart": { "name": "L:A32NX_OVHD_APU_START_PB_IS_ON", "type": "bool", "verified": false, "description": "APU START ON light" },
    "apuAvailable": { "name": "L:A32NX_OVHD_APU_START_PB_IS_AVAILABLE", "type": "bool", "verified": false, "description": "APU AVAIL" },
    "apuBleed": { "name": "L:A32NX_OVHD_PNEU_APU_BLEED_PB_IS_ON", "type": "bool", "verified": true, "description": "APU BLEED Pushbutton" },
    "apuN": { "name": "L:A32NX_APU_N", "type": "arinc429", "verified": false, "description": "APU N (%) from the ECB – as on the ECAM. On the A32NX, APU PCT RPM lags behind." },
    "apuEgt": { "name": "L:A32NX_APU_EGT", "type": "arinc429", "verified": false, "description": "APU EGT (°C) from the ECB" },
    "apuFlapOpen": { "name": "L:A32NX_APU_FLAP_OPEN_PERCENTAGE", "unit": "percent", "type": "number", "verified": false, "description": "APU air intake flap open (%)" },
    "flaps": {
      "name": "L:A32NX_FLAPS_CONF_INDEX", "type": "enum", "verified": false,
      "values": { "0": "0", "1": "1", "2": "1+F", "3": "2", "4": "3", "5": "FULL" }
    },
    // Anflug-Callouts (v0.9.2): Namen laut FBW-Doku (a320-simvars.md), im Sim noch nicht geprüft.
    // LOC/GS-Abweichung in Grad, "scale" rechnet in Dots um wie das FBW-PFD (LOC 0,8°/Dot, G/S 0,4°/Dot).
    "fmgcPhase": {
      "name": "L:A32NX_FMGC_FLIGHT_PHASE", "type": "enum", "verified": false, "description": "FMGC flight phase ('Approach phase not activated')",
      "values": { "0": "PREFLIGHT", "1": "TAKEOFF", "2": "CLIMB", "3": "CRUISE", "4": "DESCENT", "5": "APPROACH", "6": "GO AROUND", "7": "DONE" }
    },
    "locDeviation": { "name": "L:A32NX_RADIO_RECEIVER_LOC_DEVIATION", "type": "number", "scale": 1.25, "verified": false, "description": "Localizer deviation (degrees → dots)" },
    "locValid": { "name": "L:A32NX_RADIO_RECEIVER_LOC_IS_VALID", "type": "bool", "verified": false, "description": "Localizer signal valid" },
    "gsDeviation": { "name": "L:A32NX_RADIO_RECEIVER_GS_DEVIATION", "type": "number", "scale": 2.5, "verified": false, "description": "Glideslope deviation (degrees → dots)" },
    "gsValid": { "name": "L:A32NX_RADIO_RECEIVER_GS_IS_VALID", "type": "bool", "verified": false, "description": "Glideslope signal valid" }
  },
  "ecam": {
    "format": "fbw-a32nx",
    "leftLines": "L:A32NX_EWD_LOWER_LEFT_LINE_{n}",
    "rightLines": "L:A32NX_EWD_LOWER_RIGHT_LINE_{n}",
    "lines": 7
  },
  "limits": {
    // A320neo – VFE je Klappenstellung (Klartext aus "flaps")
    "vmoKt": 350,
    "vleKt": 280,
    "vloKt": 250,
    "vfeKt": { "1": 230, "1+F": 215, "2": 200, "3": 185, "FULL": 177 },
    "landingFlaps": [ "3", "FULL" ],
    "speedLimitBelowFl100Kt": 250,
    // Sicherheitssperren des Eingabe-Moduls (v0.9.1): Fahrwerk ausfahren nur unter 25 000 ft (A320-Limit),
    // Speedbrake nicht in CONF FULL (FCOM: Speedbrake-Ausfahren in CONF FULL gesperrt, A321: auch CONF 3),
    // MSA für die FCU-Höhe aus der MORA im SimBrief-Navlog.
    "maxGearAltitudeFt": 25000,
    "speedbrakeInhibitFlaps": [ "FULL" ],
    "msaSource": "ofp"
  },
  "electrical": [
    { "key": "gen1Volt", "name": "L:A32NX_ELEC_ENG_GEN_1_POTENTIAL", "description": "GEN 1 (V)" },
    { "key": "gen1Hz", "name": "L:A32NX_ELEC_ENG_GEN_1_FREQUENCY", "description": "GEN 1 (Hz)" },
    { "key": "gen2Volt", "name": "L:A32NX_ELEC_ENG_GEN_2_POTENTIAL", "description": "GEN 2 (V)" },
    { "key": "gen2Hz", "name": "L:A32NX_ELEC_ENG_GEN_2_FREQUENCY", "description": "GEN 2 (Hz)" },
    { "key": "apuGenVolt", "name": "L:A32NX_ELEC_APU_GEN_1_POTENTIAL", "description": "APU GEN (V)" },
    { "key": "apuGenHz", "name": "L:A32NX_ELEC_APU_GEN_1_FREQUENCY", "description": "APU GEN (Hz)" },
    { "key": "apuGenLoad", "name": "L:A32NX_ELEC_APU_GEN_1_LOAD", "unit": "percent", "description": "APU GEN load (%)" },
    { "key": "extPwrVolt", "name": "L:A32NX_ELEC_EXT_PWR_POTENTIAL", "description": "EXT PWR (V)" },
    { "key": "bat1Volt", "name": "L:A32NX_ELEC_BAT_1_POTENTIAL", "description": "BAT 1 (V)" },
    { "key": "bat2Volt", "name": "L:A32NX_ELEC_BAT_2_POTENTIAL", "description": "BAT 2 (V)" },
    { "key": "ac1Powered", "name": "L:A32NX_ELEC_AC_1_BUS_IS_POWERED", "description": "AC BUS 1", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "ac2Powered", "name": "L:A32NX_ELEC_AC_2_BUS_IS_POWERED", "description": "AC BUS 2", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "acEssPowered", "name": "L:A32NX_ELEC_AC_ESS_BUS_IS_POWERED", "description": "AC ESS BUS", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dc1Powered", "name": "L:A32NX_ELEC_DC_1_BUS_IS_POWERED", "description": "DC BUS 1", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dc2Powered", "name": "L:A32NX_ELEC_DC_2_BUS_IS_POWERED", "description": "DC BUS 2", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dcEssPowered", "name": "L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED", "description": "DC ESS BUS", "values": { "0": "unpowered", "1": "powered" } },
    { "key": "dcBatPowered", "name": "L:A32NX_ELEC_DC_BAT_BUS_IS_POWERED", "description": "DC BAT BUS", "values": { "0": "unpowered", "1": "powered" } }
  ],
  "variables": [
    { "key": "fireButtonEng1", "name": "L:A32NX_FIRE_BUTTON_ENG1", "unit": "number", "description": "ENG 1 Fire Pushbutton (1 = released)", "values": { "0": "IN", "1": "RELEASED" } },
    { "key": "fireGuardEng1", "name": "L:A32NX_FIRE_GUARD_ENG1", "unit": "number", "description": "ENG 1 Fire Guard" },
    { "key": "wingAntiIcePressed", "name": "L:A32NX_BUTTON_OVHD_ANTI_ICE_WING_POSITION", "unit": "number", "description": "Wing Anti-Ice Pushbutton (1 = ON)" },
    { "key": "vapp", "name": "L:A32NX_SPEEDS_VAPP", "unit": "number", "description": "VAPP from the FMS (kt)" },
    { "key": "greenDot", "name": "L:A32NX_SPEEDS_GD", "unit": "number", "description": "Green Dot (kt)" },
    { "key": "fmgcPhase", "name": "L:A32NX_FMGC_FLIGHT_PHASE", "unit": "number", "description": "FMGC flight phase",
      "values": { "0": "PREFLIGHT", "1": "TAKEOFF", "2": "CLIMB", "3": "CRUISE", "4": "DESCENT", "5": "APPROACH", "6": "GO AROUND", "7": "DONE" } }
  ],
  // Eingaben (Eingabe-Modul, v0.7): nur diese Aktionen kann Duopilo im Cockpit bedienen – nach Readback und Bestätigung.
  // Quellen: fbw-a32nx/docs/a320-events.md, a320-simvars.md, aircraft_preset_procedures.xml (FBW-Presets), Rust-Systeme.
  // "verified": false = laut FBW-Quellcode, im Sim noch nicht geprüft. Triebwerk, Feuer, Treibstoff und MCDU sind im Code gesperrt.
  // "verified": true = im Sim getestet (28.10.2026: fcu.heading, flaps, lights.beacon, antiice.engines, apu.bleed).
  // Weitere geprüfte Aktionen merkt sich Duopilo in %LOCALAPPDATA%\Duopilo\verified-actions.json.
  "actions": [
    {
      "id": "fcu.speed",
      "area": "FCU",
      "label": "FCU speed",
      "description": "Sets the speed (kt) and pulls the knob (selected). In Mach mode it switches to knots first.",
      "parameter": { "min": 100, "max": 399, "step": 1, "unit": "kt" },
      "steps": [
        {
          "event": "A32NX.FCU_SPD_MACH_TOGGLE_PUSH",
          "skipIf": { "variable": "L:A32NX_FCU_AFS_DISPLAY_MACH_MODE", "equalTo": 0 },
          "delayMs": 150
        },
        {
          "event": "A32NX.FCU_SPD_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_SPD_PULL" }
      ],
      "readback": "Speed {value} selected",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_VALUE",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.speedManaged",
      "area": "FCU",
      "label": "Managed speed",
      "steps": [
        { "event": "A32NX.FCU_SPD_PUSH" }
      ],
      "readback": "Managed speed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_MANAGED", "expect": 1 },
      "verified": false
    },
    {
      "id": "fcu.heading",
      "area": "FCU",
      "label": "FCU heading",
      "parameter": { "min": 0, "max": 360, "step": 1, "unit": "°", "format": "heading" },
      "steps": [
        {
          "event": "A32NX.FCU_HDG_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_HDG_PULL" }
      ],
      "readback": "Heading {value} selected",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_VALUE", "expect": "{value}", "modulo": 360 },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "messageKey": "profile.requires.trkFpaMode" }
      ],
      "verified": true
    },
    {
      "id": "fcu.headingManaged",
      "area": "FCU",
      "label": "Managed NAV",
      "steps": [
        { "event": "A32NX.FCU_HDG_PUSH" }
      ],
      "readback": "Heading managed",
      "description": "Pushes the HDG knob. NAV can take a few seconds to engage – so the check waits up to 10 s.",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_MANAGED", "expect": 1, "timeoutMs": 10000 },
      "verified": false
    },
    {
      "id": "fcu.altitude",
      "area": "FCU",
      "label": "FCU altitude",
      "description": "Only sets the FCU altitude – to climb or descend, follow with fcu.altitudePull or fcu.altitudePush.",
      "parameter": { "min": 100, "max": 49000, "step": 100, "unit": "ft", "format": "altitude" },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude {value} set",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_ALT_VALUE",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.altitudePull",
      "area": "FCU",
      "label": "Altitude pull",
      "steps": [
        { "event": "A32NX.FCU_ALT_PULL" }
      ],
      "readback": "Altitude pull, open climb or descent",
      "verified": false
    },
    {
      "id": "fcu.altitudePush",
      "area": "FCU",
      "label": "Altitude push",
      "steps": [
        { "event": "A32NX.FCU_ALT_PUSH" }
      ],
      "readback": "Altitude push, managed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_LVL_CH_MANAGED", "expect": 1 },
      "verified": false
    },
    {
      "id": "fcu.altIncrement",
      "area": "FCU",
      "label": "Altitude increment",
      "parameter": {
        "type": "choice",
        "options": { "100": 100, "1000": 1000 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_INCREMENT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude increment {value}",
      "check": {
        "variable": "L:A32NX_FCU_ALT_INCREMENT_1000",
        "expect": { "100": 0, "1000": 1 }
      },
      "verified": false
    },
    {
      "id": "fcu.vs",
      "area": "FCU",
      "label": "Vertical speed",
      "parameter": { "min": -6000, "max": 6000, "step": 100, "unit": "ft/min" },
      "steps": [
        {
          "event": "A32NX.FCU_VS_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_VS_PULL" }
      ],
      "readback": "Vertical speed {value}",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_VS_FPA_VALUE",
        "expect": "{value}",
        "tolerance": 50
      },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "messageKey": "profile.requires.trkFpaMode" }
      ],
      "verified": false
    },
    {
      "id": "fcu.loc",
      "area": "FCU",
      "label": "LOC",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_LOC_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_LOC_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "LOC {value}",
      "check": {
        "variable": "L:A32NX_FCU_LOC_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.appr",
      "area": "FCU",
