<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows-Anwendung ohne Konsolenfenster: Duopilo sitzt im Infobereich. Der Schalter "console" öffnet bei Bedarf eine Konsole. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\duopilo.ico</ApplicationIcon>
    <!-- Programmdatei Duopilo.exe (bis 0.9.x Kopilot.exe). Installer und Release lesen den Namen von hier (installer/installer.ps1). -->
    <AssemblyName>Duopilo</AssemblyName>
    <RootNamespace>Duopilo</RootNamespace>
    <!-- Nur für lokale Builds (update.cmd). Releases setzen die Version aus dem Tag v… (.github/workflows/release.yml). -->
    <Version>0.10.0-beta.22</Version>
    <!-- SimConnect.dll ist eine native x64-Bibliothek -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- Kokoro-82M (Apache 2.0) über KokoroSharp (MIT), ONNX Runtime auf der CPU. Wiedergabe über den Windows-Player wie die Windows-Stimmen. -->
    <PackageReference Include="KokoroSharp" Version="0.8.4" GeneratePathProperty="true" />
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <!--
      Sprachschleife (v0.9): Whisper über Whisper.net (MIT, whisper.cpp), CPU-Laufzeit plus Vulkan für die GPU-Option.
      Mikrofon über NAudio (MIT, WinMM). Silero VAD (MIT) läuft über die ONNX Runtime, die KokoroSharp schon mitbringt.
      Modelle lädt Duopilo erst, wenn die Sprachschleife eingeschaltet ist, nach %LOCALAPPDATA%\Duopilo\models.
    -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- Core Audio: volle Gerätenamen und das Windows-Standardmikrofon für Status und Dashboard (Aufnahme selbst bleibt WinMM) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!--
    Kokoro-Stimmen: KokoroSharp kopiert beim Build alle Stimmen (auch Chinesisch usw.) nach bin, aber nicht beim Publish.
    Ins veröffentlichte Programm kommen nur die englischen (a = amerikanisch, b = britisch), ca. 15 MB.
    Das Modell selbst (~310 MB) lädt Duopilo erst, wenn Kokoro gebraucht wird, nach %LOCALAPPDATA%\Duopilo\models.
  -->
  <ItemGroup Condition="'$(PkgKokoroSharp)' != ''">
    <None Include="$(PkgKokoroSharp)\content\voices\a?_*.npy;$(PkgKokoroSharp)\content\voices\b?_*.npy" Link="voices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Dashboard, Schriften (B612, SIL OFL 1.1) und Symbole stecken in der Duopilo.dll -->
  <ItemGroup>
    <EmbeddedResource Include="Dashboard\dashboard.html" LogicalName="Duopilo.Dashboard.dashboard.html" />
    <EmbeddedResource Include="Dashboard\fonts\*.woff" LogicalName="Duopilo.Dashboard.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\duopilo.ico" LogicalName="Duopilo.Dashboard.favicon.ico" />
    <EmbeddedResource Include="Assets\tray-*.ico" LogicalName="Duopilo.Assets.%(Filename)%(Extension)" />
    <!-- Sprachdateien (i18n\<code>.json): Dashboard, Tool-Meldungen und Logs. Englisch ist Standard und Fallback. -->
    <EmbeddedResource Include="i18n\*.json" LogicalName="Duopilo.i18n.%(Filename)%(Extension)" />
    <None Update="Dashboard\fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="licenses\B612-OFL.txt" />
    <!-- Supertonic-Inferenz (Speech\SupertonicModel.cs) folgt dem MIT-lizenzierten Beispiel von Supertone; die Gewichte (OpenRAIL-M) lädt Duopilo bei Bedarf -->
    <None Update="Speech\Supertonic-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="licenses\Supertonic-MIT.txt" />
    <!-- Lizenz von Duopilo (MIT) und Hinweise zu Drittkomponenten gehören in jede Weitergabe (Installer, ZIP) -->
    <None Include="..\..\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="LICENSE.txt" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>

  <!--
    WinForms bringt globale usings für System.Windows.Forms und System.Drawing mit. Die kollidieren mit Namen wie
    Timer oder Binding im übrigen Code – deshalb raus damit, der Tray-Code nutzt Aliase.
  -->
  <Target Name="DuopiloRemoveWinFormsUsings" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Windows.Forms" />
      <Using Remove="System.Drawing" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Local.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="atc-templates.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Vorlage – beim ersten Start nach %LOCALAPPDATA%\Duopilo\voice-settings.json kopiert (update.cmd überschreibt die nicht) -->
    <Content Update="voice-settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Lokale Geheimnisse nie mitkopieren, falls die Datei versehentlich im Projektordner liegt -->
    <Content Remove="appsettings.Local.json" />
    <!-- Sprachdateien stecken in der Duopilo.dll (EmbeddedResource oben) -->
    <Content Remove="i18n\**" />
    <None Remove="i18n\**" />
    <Content Update="profiles\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Luftraum- und Airline-Daten (data\README.md): VAT-Spy (FIR-Grenzen, CC BY-SA 4.0), Streckensektoren aus VATGlasses
    (CC BY-NC-SA 4.0, erzeugt mit tools\import_sectors.py) und OpenFlights-Airlines (ODbL). Lizenzen liegen jeweils daneben.
  -->
  <ItemGroup>
    <None Remove="data\**" />
    <Content Remove="data\**" />
    <Content Include="data\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SimConnect-Referenz. Reihenfolge der Suche:
      1. lib\ im Repo (DLLs manuell hineinkopiert)
      2. Umgebungsvariable MSFS2024_SDK
      3. Standardpfad C:\MSFS 2024 SDK\
    Wird nichts gefunden (oder UseSimConnectStub=true gesetzt), wird gegen einen Stub gebaut.
    Der Stub kompiliert, kann sich aber nicht mit MSFS verbinden – nur für CI.
  -->
  <PropertyGroup>
    <_DuopiloRepoLib>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'lib'))</_DuopiloRepoLib>
    <_DuopiloSdkRoot Condition="'$(MSFS2024_SDK)' != ''">$([MSBuild]::EnsureTrailingSlash('$(MSFS2024_SDK)'))</_DuopiloSdkRoot>
    <_DuopiloSdkRoot Condition="'$(_DuopiloSdkRoot)' == ''">C:\MSFS 2024 SDK\</_DuopiloSdkRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseSimConnectStub)' != 'true' and Exists('$(_DuopiloRepoLib)Microsoft.FlightSimulator.SimConnect.dll')">
    <SimConnectManagedDll>$(_DuopiloRepoLib)Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectNativeDll>$(_DuopiloRepoLib)SimConnect.dll</SimConnectNativeDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseSimConnectStub)' != 'true' and '$(SimConnectManagedDll)' == '' and Exists('$(_DuopiloSdkRoot)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">
    <SimConnectManagedDll>$(_DuopiloSdkRoot)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectNativeDll>$(_DuopiloSdkRoot)SimConnect SDK\lib\SimConnect.dll</SimConnectNativeDll>
  </PropertyGroup>

  <!--
    BundleSimConnect=false (Release-Pipeline): gegen das echte SimConnect bauen, die DLLs aber nicht ausliefern – sie gehören zum
    MSFS-SDK. Zur Laufzeit lädt Duopilo sie aus dem installierten SDK (Sim/SimConnectLocator.cs) und bietet sonst die Installation
    an. Lokale Builds (update.cmd) legen sie wie bisher neben Duopilo.exe.
  -->
  <PropertyGroup>
    <BundleSimConnect Condition="'$(BundleSimConnect)' == ''">true</BundleSimConnect>
  </PropertyGroup>

  <ItemGroup Condition="'$(SimConnectManagedDll)' != ''">
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDll)</HintPath>
      <Private>$(BundleSimConnect)</Private>
    </Reference>
    <None Include="$(SimConnectNativeDll)" Link="SimConnect.dll" Condition="'$(BundleSimConnect)' == 'true' and Exists('$(SimConnectNativeDll)')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(SimConnectManagedDll)' == ''">
    <ProjectReference Include="..\SimConnectStub\SimConnectStub.csproj" />
  </ItemGroup>

  <Target Name="DuopiloSimConnectInfo" BeforeTargets="CoreCompile">
    <Message Importance="high" Condition="'$(SimConnectManagedDll)' != ''" Text="Duopilo: SimConnect aus $(SimConnectManagedDll)" />
    <Warning Condition="'$(SimConnectManagedDll)' == ''" Text="Duopilo: Kein MSFS-2024-SDK gefunden – Build läuft gegen den SimConnect-Stub. So kann sich Duopilo NICHT mit MSFS verbinden. Siehe README, Abschnitt 'SimConnect-SDK'." />
    <Warning Condition="'$(SimConnectManagedDll)' != '' and !Exists('$(SimConnectNativeDll)')" Text="Duopilo: Native SimConnect.dll nicht gefunden unter $(SimConnectNativeDll). Bitte manuell neben Duopilo.exe kopieren." />
  </Target>

  <!--
    Von der Release-Pipeline gebaut (ContinuousIntegrationBuild, .github/workflows/release.yml): nur diese Stände sehen in den
    GitHub-Releases nach Updates (Updates/UpdateService.cs). Selbst gebaute (update.cmd) aktualisiert update.cmd.
  -->
  <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DuopiloReleaseBuild</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
