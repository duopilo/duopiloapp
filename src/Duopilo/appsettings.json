{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Duopilo": {
    "Transport": "http",
    "Language": "en",
    "ClientName": "Duopilo",
    "ReconnectSeconds": 5,
    "ReadTimeoutMs": 3000,
    "HttpUrl": "http://127.0.0.1:5155",
    "ProfilesDirectory": "profiles",
    "FastIntervalFrames": 4,
    "DataDirectory": "",
    "RestartAfterCrash": true,
    "SimBrief": {
      "Username": "",
      "PilotId": "",
      "CacheMinutes": 10
    },
    "Monitoring": {
      "Enabled": true,
      "IntervalMs": 200,
      "DisabledRules": [],
      "HistorySize": 500,
      "AircraftAutoCallouts": false,
      "Traffic": {
        "ProximityRangeNm": 3,
        "ProximityAltitudeFt": 1000,
        "ProximityCooldownSec": 60,
        "ScanIntervalSec": 3,
        "AltitudeReference": "Pressure",
        "MessageLog": true
      },
      "FuelCheck": {
        "IntervalMinutes": 30,
        "DeviationIncreaseKg": 300,
        "LandingBufferKg": 500,
        "MinSpacingMinutes": 0
      }
    },
    "Input": {
      "Enabled": false,
      "ConfirmWindowSeconds": 60
    },
    "Atc": {
      "Enabled": true,
      "TemplatesFile": "atc-templates.json",
      "Speak": true,
      "SessionFile": "atc-session.json",
      "SessionMaxAgeHours": 24,
      "SquawkFromSim": false
    },
    "Speech": {
      "Enabled": true,
      "Voice": "",
      "Device": "",
      "Volume": 1.0,
      "Rate": 1.1,
      "MinSeverity": "Info",
      "Engine": "auto",
      "KokoroVoice": "bm_george",
      "KokoroModelPath": "",
      "KokoroThreads": 2
    },
    "Smalltalk": {
      "Provider": "off",
      "Model": "",
      "Url": "",
      "MaxReplyWords": 40,
      "RequestsPerMinute": 6,
      "TimeoutSec": 10,
      "UnaddressedMaxWords": 12,
      "PiperPath": ""
    },
    "FirstOfficer": {
      "Enabled": true,
      "Name": "",
      "Gender": "auto",
      "Introduce": true
    },
    "Reports": {
      "GitHubRepository": "duopilo/duopiloapp",
      "IssueTemplate": "duopilo-meldung.yml",
      "Directory": ""
    },
    "Remote": {
      "PublicUrl": "",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 90,
      "StateFile": ""
    }
  }
}
