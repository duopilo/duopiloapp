// Bahnregeln für Duopilos eigenen Verkehr (Verkehrstest). Eigene Regeln: dieselbe Datei im Datenordner unter data\traffic\ –
// ein Flughafen dort ersetzt die Regeln hier. Felder je Regel: runways (Bahnen), operations ("arrival", "departure"; fehlt = alle,
// leer = gesperrt), categories ("airliner", "generalaviation"), excludeTypes (ICAO-Typen, "*" am Ende als Präfix), maxWake
// ("light", "medium", "heavy", "super"), note. Länge und Breite prüft Duopilo zusätzlich selbst.
{
  "airports": {
    "EDDF": {
      "note": "Frankfurt",
      "runways": [
        {
          "runways": ["07L", "25R"],
          "operations": ["arrival"],
          "excludeTypes": ["B74*", "A388", "MD11", "A124", "L101"],
          "note": "Landebahn Nordwest: nur Landungen, keine B747, A380, MD-11, An-124, L-1011"
        },
        {
          "runways": ["18"],
          "operations": ["departure"],
          "note": "Startbahn West: nur Starts nach Süden"
        },
        {
          "runways": ["36"],
          "operations": [],
          "note": "Startbahn West: nur Starts nach Süden"
        }
      ]
    }
  }
}
