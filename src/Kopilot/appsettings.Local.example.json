{
  // Vorlage: als "appsettings.Local.json" neben die Kopilot.exe kopieren (z. B. C:\Tools\Kopilot\)
  // und ausfüllen. Die echte Datei wird nie eingecheckt (.gitignore) und von update.cmd nicht überschrieben.
  //
  // BearerToken:     mit "Kopilot.exe --generate-secret" erzeugen (mindestens 32 Zeichen)
  // ConsentPassword: eigenes Passwort für die Freigabeseite beim Verbinden in Claude (mindestens 12 Zeichen)
  //
  // Leere Werte bedeuten: Dieser Zugangsweg ist aus.
  //
  // SimBrief: Username ODER PilotId (simbrief.com → Account Settings) – für get_flight_plan, get_progress und L/C/R der ATC-Bahn.
  // Monitoring.DisabledRules: Regeln abschalten, z. B. [ "SPEED_DEVIATION", "ALT_1000_TO_GO", "TRAFFIC_PROXIMITY" ].
  // Monitoring.Traffic: Grenzen der Verkehrswarnung (ProximityRangeNm, ProximityAltitudeFt, ProximityCooldownSec, ScanIntervalSec).
  //                    AltitudeReference: "Pressure" (Standard, Höhendifferenz gegen die eigene Druckhöhe) oder "True" (gegen die wahre Höhe).
  //                    MessageLog: false schaltet logs\traffic-messages.csv ab (Prüfung der SimConnect-Antworten, Absturzanalyse 0.9).
  // Sprachausgabe (Stimme, Ausgabegerät, Lautstärke): im Dashboard unter Ansagen → Stimme, gespeichert in %LOCALAPPDATA%\Kopilot\speech.json.
  // Eingabe-Modul: standardmäßig gesperrt. Freigabe im Dashboard (Eingabe gesperrt → zweimal klicken) oder hier mit "Input": { "Enabled": true }.
  "Kopilot": {
    "Transport": "http",
    "SimBrief": {
      "Username": "",
      "PilotId": ""
    },
    "Monitoring": {
      "DisabledRules": []
    },
    "Remote": {
      "PublicUrl": "https://kopilot.flo210500.com",
      "BearerToken": "",
      "ConsentPassword": ""
    }
  }
}
