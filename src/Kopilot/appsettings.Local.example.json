{
  // Vorlage: als "appsettings.Local.json" neben die Kopilot.exe kopieren (z. B. C:\Tools\Kopilot\)
  // und ausfüllen. Die echte Datei wird nie eingecheckt (.gitignore) und von update.cmd nicht überschrieben.
  //
  // BearerToken:     mit "Kopilot.exe --generate-secret" erzeugen (mindestens 32 Zeichen)
  // ConsentPassword: eigenes Passwort für die Freigabeseite beim Verbinden in Claude (mindestens 12 Zeichen)
  //
  // Leere Werte bedeuten: Dieser Zugangsweg ist aus.
  //
  // SimBrief: Username ODER PilotId (simbrief.com → Account Settings) – für get_flight_plan, get_progress und L/C/R der ATC-Bahn.
  // Monitoring.DisabledRules: Regeln abschalten, z. B. [ "SPEED_DEVIATION", "ALT_1000_TO_GO" ].
  // Speech: eigene Sprachausgabe der Callouts. Stimme und an/aus gehen auch im Dashboard.
  //   OutputDevice: Teil des Gerätenamens, z. B. "Headset" (leer = Windows-Standard)
  //   MutedRules:   nur anzeigen, nicht sprechen, z. B. [ "RUNWAY_ASSIGNED" ]
  //   Enabled:      false = gar nicht laden, dann liest wieder der Browser vor
  "Kopilot": {
    "Transport": "http",
    "SimBrief": {
      "Username": "",
      "PilotId": ""
    },
    "Monitoring": {
      "DisabledRules": []
    },
    "Speech": {
      "Voice": "bm_george",
      "OutputDevice": "",
      "MutedRules": []
    },
    "Remote": {
      "PublicUrl": "https://kopilot.flo210500.com",
      "BearerToken": "",
      "ConsentPassword": ""
    }
  }
}
