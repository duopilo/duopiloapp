    "tower": { "name": "Tower", "placeholderFrequency": "118.700" },
    "departure": { "name": "Departure", "placeholderFrequency": "124.350" },
    "center": { "name": "Control", "placeholderFrequency": "132.600" },
    "oceanic": { "name": "Oceanic", "placeholderFrequency": "127.650" },
