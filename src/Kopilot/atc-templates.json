  "messages": {
    "delivery.request": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, request IFR clearance to {dest}" ]
    },
    "delivery.clearance": {
      "variants": [
        "{callsign}, cleared to {dest}, {sid} departure, runway {runway}, climb {initialAlt}, squawk {squawk}",
        "{callsign}, cleared to {dest}, runway {runway}, climb {initialAlt}, squawk {squawk}"
      ],
      "readback": [ "sid", "initialAlt", "squawk" ]
    },
    "delivery.readbackCorrect": {
      "variants": [ "{callsign}, readback correct, contact Ground {freq}" ]
    },

    "ground.pushRequest": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, gate {gate}, request push and start", "{station}, {callsign}, request push and start" ]
    },
    "ground.pushApproved": {
      "variants": [ "{callsign}, push and start approved, facing {direction}", "{callsign}, push and start approved" ]
    },
    "ground.taxiRequest": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, request taxi" ]
    },
    "ground.taxi": {
      "variants": [
        "{callsign}, taxi to holding point {holdingPoint} runway {runway} via {taxiRoute}",
        "{callsign}, taxi to holding point {holdingPoint} runway {runway}",
        "{callsign}, taxi to holding point runway {runway}"
      ],
      "readback": [ "holdingPoint", "runway" ]
    },
    "ground.handoffTower": {
      "variants": [ "{callsign}, contact Tower {freq}" ]
    },

    "tower.readyRequest": {
      "from": "pilot",
      "variants": [
        "{station}, {callsign}, holding point {holdingPoint} runway {runway}, ready for departure",
        "{station}, {callsign}, holding point runway {runway}, ready for departure"
      ]
    },
    "tower.lineUp": {
      "variants": [ "{callsign}, line up and wait runway {runway}" ],
      "readback": [ "runway" ]
    },
    "tower.takeoff": {
      "variants": [ "{callsign}, wind {wind}, runway {runway}, cleared for takeoff", "{callsign}, runway {runway}, cleared for takeoff" ],
      "readback": [ "runway" ]
    },
    "tower.handoffDeparture": {
      "variants": [ "{callsign}, contact Departure {freq}" ]
    },

    "departure.contact": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, passing {altitude}, climbing {initialAlt}" ]
    },
    "departure.identified": {
      "variants": [ "{callsign}, identified, climb {level}" ],
      "readback": [ "level" ]
    },
    "departure.direct": {
      "variants": [ "{callsign}, proceed direct {fix}" ],
      "readback": [ "fix" ]
    },
    "departure.handoff": {
      "variants": [ "{callsign}, contact {nextCenter} {freq}" ]
    },

    "center.contactClimbing": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, passing {altitude}, climbing {level}" ]
    },
    "center.contactLevel": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, maintaining {altitude}" ]
    },
    "center.contactDescending": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, passing {altitude}, descending {level}" ]
    },
    "center.climb": {
      "variants": [ "{callsign}, climb {level}" ],
      "readback": [ "level" ]
    },
    "center.descend": {
      "variants": [ "{callsign}, descend {level}" ],
      "readback": [ "level" ]
    },
    "center.identified": {
      "variants": [ "{callsign}, identified, maintain {level}", "{callsign}, identified" ]
    },
    "center.handoff": {
      "variants": [ "{callsign}, contact {nextCenter} {freq}" ]
    },
    "center.handoffApproach": {
      "variants": [ "{callsign}, contact {nextCenter} {freq}" ]
    },

    "oceanic.request": {
      "from": "pilot",
      "variants": [
        "{station}, {callsign}, request oceanic clearance, estimating {entryFix} at {eta}, requesting {level}, speed {speedKt} knots",
        "{station}, {callsign}, request oceanic clearance, estimating {entryFix} at {eta}, requesting {level}"
      ]
    },
    "oceanic.clearance": {
      "variants": [
        "{callsign}, cleared to {dest} via {entryFix}, {route}, maintain {level}, speed {speedKt} knots",
        "{callsign}, cleared to {dest} via {entryFix}, maintain {level}, speed {speedKt} knots",
        "{callsign}, cleared to {dest} via {entryFix}, maintain {level}"
      ],
      "readback": [ "entryFix", "level", "speedKt" ]
    },
    "oceanic.readbackCorrect": {
      "variants": [ "{callsign}, readback correct" ]
    },
    "oceanic.position": {
      "from": "pilot",
      "variants": [
        "{station}, {callsign}, position {fix} at {time}, {level}, estimating {nextFix} at {eta}",
        "{station}, {callsign}, position {fix} at {time}, {level}"
      ]
    },
    "oceanic.roger": {
      "variants": [ "{callsign}, roger" ]
    },
    "oceanic.handoff": {
      "variants": [ "{callsign}, contact {nextCenter} {freq}" ]
    },

    "approach.contact": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, descending {level}", "{station}, {callsign}, {altitude}" ]
    },
    "approach.descend": {
      "variants": [
        "{callsign}, descend {level}, {star} arrival, expect {approach} runway {runway}, {qnh}",
        "{callsign}, descend {level}, expect {approach} runway {runway}, {qnh}",
        "{callsign}, descend {level}, expect {approach} runway {runway}"
      ],
      "readback": [ "level", "runway", "qnh" ]
    },
    "approach.cleared": {
      "variants": [ "{callsign}, cleared {approach} runway {runway}" ],
      "readback": [ "approach", "runway" ]
    },
    "approach.handoff": {
      "variants": [ "{callsign}, contact Tower {freq}" ]
    },

    "tower.landingContact": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, {approach} runway {runway}" ]
    },
    "tower.landing": {
      "variants": [ "{callsign}, wind {wind}, runway {runway}, cleared to land", "{callsign}, runway {runway}, cleared to land" ],
      "readback": [ "runway" ]
    },
    "tower.vacate": {
      "variants": [ "{callsign}, vacate via next exit, contact Ground {freq}" ]
    },

    "ground.arrivalContact": {
      "from": "pilot",
      "variants": [ "{station}, {callsign}, runway {runway} vacated" ]
    },
    "ground.taxiToGate": {
      "variants": [ "{callsign}, taxi to gate {gate} via {taxiRoute}", "{callsign}, taxi to gate {gate}", "{callsign}, taxi to parking" ],
      "readback": [ "gate" ]
    },

    "common.negative": {
      "variants": [ "{callsign}, negative, {corrections}" ]
    },
    "common.roger": {
      "variants": [ "{callsign}, roger" ]
    },
    "common.sayAgain": {
      "variants": [ "{callsign}, say again" ]
    },
    "common.radioCheck": {
      "variants": [ "{callsign}, read you five" ]
    }
  },

  "corrections": {
    "sid": "{sid} departure",
    "star": "{star} arrival",
    "approach": "{approach} approach",
    "runway": "runway {runway}",
    "initialAlt": "climb {initialAlt}",
    "level": "{levelVerb} {level}",
    "squawk": "squawk {squawk}",
    "freq": "{freq}",
    "holdingPoint": "holding point {holdingPoint}",
    "gate": "gate {gate}",
    "speedKt": "speed {speedKt} knots",
    "entryFix": "via {entryFix}",
    "heading": "heading {heading}",
    "qnh": "{qnh}",
    "fix": "direct {fix}"
  },

  "words": {
    "climb": "climb",
    "descend": "descend",
    "maintain": "maintain"
  }
}
