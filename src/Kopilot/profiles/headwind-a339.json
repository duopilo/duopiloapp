{
  // Headwind A330-900neo (MSFS 2024, Community-Paket headwindsim-aircraft-a330-900). Basiert auf FlyByWire – Grundlage ist das A32NX-Profil.
  // Bindings: "verified": true = in der Testsession am 28.10.2026 im Sim geprüft. Alles andere stammt aus dem A32NX-Profil und ist ungeprüft.
  //
  // Bewusst NICHT übernommen (beim A330 anders oder nicht gefunden – ein unbekanntes L: liest 0 und würde Fehlalarme auslösen):
  //   athrMode (L:A32NX_AUTOTHRUST_MODE bleibt 0), ALT CRZ (fmgcDiscreteWord1), speedTarget, machMode, groundSpoilersOut, decelLight, ECAM-Zeilen.
  // Unbrauchbar (generisch): BRAKE PARKING POSITION/INDICATOR, EXTERNAL POWER ON:1, AUTOPILOT MASTER, generischer Fuel Flow/EGT, AUTO BRAKE SWITCH CB.
  "name": "Headwind A330-900neo",
  "match": [
    { "path": [ "headwind", "a330" ] },
    { "path": [ "headwind_a330neo" ] },
    { "title": [ "A330-900neo" ] }
  ],
  "notes": "Basiert auf FlyByWire. FCU-Werte kommen aus den älteren FBW-Variablen (AUTOPILOT_SPEED_SELECTED, FCU_HEADING_SELECTED, ALTITUDE LOCK VAR:3). Thrust-Modus (THR CLB, SPEED), ALT CRZ und ECAM sind noch offen. Eingaben wie beim A32NX; FCU, Lights, Anti-Ice, External Power und APU im Sim getestet, der Rest ungeprüft.",
  "bindings": {
    "ap1": { "name": "L:A32NX_AUTOPILOT_1_ACTIVE", "type": "bool", "verified": true },
    "ap2": { "name": "L:A32NX_AUTOPILOT_2_ACTIVE", "type": "bool", "verified": true },
    "athrStatus": {
      "name": "L:A32NX_AUTOTHRUST_STATUS", "type": "enum", "verified": true,
      "values": { "0": "OFF", "1": "ARMED", "2": "ACTIVE" }
    },
    "fmaLateral": {
      "name": "L:A32NX_FMA_LATERAL_MODE", "type": "enum", "verified": true,
      "values": {
        "0": "", "10": "HDG", "11": "TRK", "20": "NAV", "30": "LOC*", "31": "LOC", "32": "LAND", "33": "FLARE",
        "34": "ROLL OUT", "40": "RWY", "41": "RWY TRK", "50": "GA TRK"
      }
    },
    "fmaLateralArmed": {
      "name": "L:A32NX_FMA_LATERAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "NAV", "1": "LOC" }
    },
    "fmaVertical": {
      "name": "L:A32NX_FMA_VERTICAL_MODE", "type": "enum", "verified": true,
      "description": "ALT CRZ wird hier nicht gemeldet (0) – noch offen",
      "values": {
        "0": "", "10": "ALT", "11": "ALT*", "12": "OP CLB", "13": "OP DES", "14": "V/S", "15": "FPA",
        "20": "ALT CST", "21": "ALT CST*", "22": "CLB", "23": "DES", "24": "FINAL", "30": "G/S*", "31": "G/S",
        "32": "LAND", "33": "FLARE", "34": "ROLL OUT", "40": "SRS", "41": "SRS GA", "50": "TCAS"
      }
    },
    "fmaVerticalArmed": {
      "name": "L:A32NX_FMA_VERTICAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "ALT", "1": "ALT CST", "2": "CLB", "3": "DES", "4": "G/S", "5": "FINAL", "6": "TCAS" }
    },
    "autobrake": {
      "name": "L:A32NX_AUTOBRAKES_ARMED_MODE", "type": "enum", "verified": true,
      "values": { "0": "OFF", "1": "LO", "2": "MED", "3": "MAX" }
    },
    "masterWarning": { "name": "L:A32NX_MASTER_WARNING", "type": "bool", "verified": true },
    "masterCaution": { "name": "L:A32NX_MASTER_CAUTION", "type": "bool", "verified": false, "description": "0 geprüft, Auslösen auf 1 noch nicht" },
    "speedManaged": { "name": "L:A32NX_FCU_SPD_MANAGED_DOT", "type": "bool", "verified": true, "description": "Managed-Punkt im SPD-Fenster" },
    "selectedSpeed": { "name": "L:A32NX_AUTOPILOT_SPEED_SELECTED", "type": "number", "verified": true, "description": "Gewählte Speed in kt, −1 bei managed" },
    "selectedHeading": { "name": "L:A32NX_FCU_HEADING_SELECTED", "type": "number", "verified": true, "description": "Gewählter Kurs" },
    "selectedHeadingDashes": { "name": "L:A32NX_FCU_HDG_MANAGED_DASHES", "type": "bool", "verified": true, "description": "HDG-Fenster zeigt Striche (managed)" },
    "selectedAltitude": { "name": "AUTOPILOT ALTITUDE LOCK VAR:3", "unit": "feet", "type": "number", "verified": true, "description": "FCU-Höhe (Index 3)" },
    "fuelFlowKgh": { "name": "L:A32NX_ENGINE_FF:{i}", "type": "number", "verified": false, "description": "Fuel Flow je Triebwerk – liefert Werte, Einheit vermutlich kg/h" },
    "egtC": { "name": "L:A32NX_ENGINE_EGT:{i}", "type": "number", "verified": true, "description": "EGT je Triebwerk in °C" },
    "parkingBrake": { "name": "L:A32NX_PARK_BRAKE_LEVER_POS", "type": "bool", "verified": true },
    "apuMaster": { "name": "L:A32NX_OVHD_APU_MASTER_SW_PB_IS_ON", "type": "bool", "verified": true },
    "apuStart": { "name": "L:A32NX_OVHD_APU_START_PB_IS_ON", "type": "bool", "verified": true },
    "apuAvailable": { "name": "L:A32NX_OVHD_APU_START_PB_IS_AVAILABLE", "type": "bool", "verified": true },
    "apuN": { "name": "L:A32NX_APU_N", "type": "arinc429", "verified": true, "description": "APU N (%) aus dem ECB" },
    "spoilersArmed": { "name": "L:A32NX_SPOILERS_ARMED", "type": "bool", "verified": false },
    "vls": { "name": "L:A32NX_SPEEDS_VLS", "type": "number", "verified": false },
    "v1": { "name": "L:AIRLINER_V1_SPEED", "unit": "knots", "type": "number", "verified": false },
    "vr": { "name": "L:AIRLINER_VR_SPEED", "unit": "knots", "type": "number", "verified": false },
    "v2": { "name": "L:AIRLINER_V2_SPEED", "unit": "knots", "type": "number", "verified": false },
    "tdReached": { "name": "L:A32NX_PFD_MSG_TD_REACHED", "type": "bool", "verified": false },
    "transAlt": { "name": "L:A32NX_FM1_TRANS_ALT", "type": "arinc429", "verified": false },
    "transLevel": { "name": "L:A32NX_FM1_TRANS_LVL", "type": "arinc429", "scale": 100, "verified": false },
    "decisionHeight": { "name": "L:A32NX_FM1_DECISION_HEIGHT", "type": "arinc429", "verified": false },
    "minimumDescentAltitude": { "name": "L:A32NX_FM1_MINIMUM_DESCENT_ALTITUDE", "type": "arinc429", "verified": false },
    "flaps": {
      "name": "L:A32NX_FLAPS_CONF_INDEX", "type": "enum", "verified": false,
      "values": { "0": "0", "1": "1", "2": "1+F", "3": "2", "4": "3", "5": "FULL" }
    }
  },
  "limits": {
    // A330-Werte (VFE je Stellung, VLO/VLE 250 kt) – für den -900neo bitte gegen das Headwind-Handbuch prüfen
    "vmoKt": 330,
    "vleKt": 250,
    "vloKt": 250,
    "vfeKt": { "1": 240, "1+F": 215, "2": 196, "3": 186, "FULL": 180 },
    "landingFlaps": [ "3", "FULL" ],
    "speedLimitBelowFl100Kt": 250
  },
  "variables": [
    { "key": "bat1Auto", "name": "L:A32NX_OVHD_ELEC_BAT_1_PB_IS_AUTO", "description": "BAT 1", "values": { "0": "OFF", "1": "AUTO" } },
    { "key": "bat2Auto", "name": "L:A32NX_OVHD_ELEC_BAT_2_PB_IS_AUTO", "description": "BAT 2", "values": { "0": "OFF", "1": "AUTO" } },
    { "key": "gen1On", "name": "L:A32NX_OVHD_ELEC_ENG_GEN_1_PB_IS_ON", "description": "GEN 1", "values": { "0": "OFF", "1": "ON" } },
    { "key": "extPwrOn", "name": "L:A32NX_OVHD_ELEC_EXT_PWR_PB_IS_ON", "description": "EXT PWR", "values": { "0": "OFF", "1": "ON" } },
    { "key": "apuFault", "name": "L:A32NX_OVHD_APU_MASTER_SW_PB_HAS_FAULT", "description": "APU MASTER FAULT", "values": { "0": "–", "1": "FAULT" } },
    { "key": "adiru1State", "name": "L:A32NX_ADIRS_ADIRU_1_STATE", "description": "ADIRU 1", "values": { "0": "OFF", "1": "ALIGNING", "2": "ALIGNED" } }
  ],
  // Eingaben: 1:1 aus dem A32NX-Profil, dazu die eigenen A330-Fassungen von External Power und APU.
  // "verified": true = im Sim mit der A339 getestet (FCU, Lights, Anti-Ice, External Power, APU).
  // Angepasst für die A339 (noch ungeprüft): signs.seatbelts (3 Stellungen), signs.noSmoking (Enum), lights.landing (LIGHT LANDING:2),
  // fcu.headingManaged (Prüfung wartet länger). Alle übrigen Bereiche sind ungeprüft übernommen.
  "actions": [
    {
      "id": "fcu.speed",
      "area": "FCU",
      "label": "FCU speed",
      "description": "Setzt die Speed (kt) und zieht den Knopf (selected). Im Mach-Modus wird vorher auf Knoten umgeschaltet.",
      "parameter": { "min": 100, "max": 399, "step": 1, "unit": "kt" },
      "steps": [
        {
          "event": "A32NX.FCU_SPD_MACH_TOGGLE_PUSH",
          "skipIf": { "variable": "L:A32NX_FCU_AFS_DISPLAY_MACH_MODE", "equalTo": 0 },
          "delayMs": 150
        },
        {
          "event": "A32NX.FCU_SPD_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_SPD_PULL" }
      ],
      "readback": "Speed {value} selected",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_VALUE",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.speedManaged",
      "area": "FCU",
      "label": "Managed speed",
      "steps": [
        { "event": "A32NX.FCU_SPD_PUSH" }
      ],
      "readback": "Managed speed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_MANAGED", "expect": 1 },
      "verified": true
    },
    {
      "id": "fcu.heading",
      "area": "FCU",
      "label": "FCU heading",
      "parameter": { "min": 0, "max": 360, "step": 1, "unit": "°", "format": "heading" },
      "steps": [
        {
          "event": "A32NX.FCU_HDG_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_HDG_PULL" }
      ],
      "readback": "Heading {value} selected",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_VALUE", "expect": "{value}", "modulo": 360 },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "message": "FCU steht auf TRK/FPA – erst auf HDG/VS umschalten." }
      ],
      "verified": true
    },
    {
      "id": "fcu.headingManaged",
      "area": "FCU",
      "label": "Managed NAV",
      "steps": [
        { "event": "A32NX.FCU_HDG_PUSH" }
      ],
      "readback": "Heading managed",
      "description": "HDG-Knopf drücken. NAV braucht beim A330 einige Sekunden – deshalb wartet die Prüfung bis zu 10 s.",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_MANAGED", "expect": 1, "timeoutMs": 10000 },
      "verified": false
    },
    {
      "id": "fcu.altitude",
      "area": "FCU",
      "label": "FCU altitude",
      "description": "Stellt nur die Höhe am FCU ein – für Steig-/Sinkflug danach fcu.altitudePull oder fcu.altitudePush.",
      "parameter": { "min": 100, "max": 49000, "step": 100, "unit": "ft", "format": "altitude" },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude {value} set",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_ALT_VALUE",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.altitudePull",
      "area": "FCU",
      "label": "Altitude pull",
      "steps": [
        { "event": "A32NX.FCU_ALT_PULL" }
      ],
      "readback": "Altitude pull, open climb or descent",
      "verified": true
    },
    {
      "id": "fcu.altitudePush",
      "area": "FCU",
      "label": "Altitude push",
      "steps": [
        { "event": "A32NX.FCU_ALT_PUSH" }
      ],
      "readback": "Altitude push, managed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_LVL_CH_MANAGED", "expect": 1 },
      "verified": true
    },
    {
      "id": "fcu.altIncrement",
      "area": "FCU",
      "label": "Altitude increment",
      "parameter": {
        "type": "choice",
        "options": { "100": 100, "1000": 1000 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_INCREMENT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude increment {value}",
      "check": {
        "variable": "L:A32NX_FCU_ALT_INCREMENT_1000",
        "expect": { "100": 0, "1000": 1 }
      },
      "verified": true
    },
    {
      "id": "fcu.vs",
      "area": "FCU",
      "label": "Vertical speed",
      "parameter": { "min": -6000, "max": 6000, "step": 100, "unit": "ft/min" },
      "steps": [
        {
          "event": "A32NX.FCU_VS_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_VS_PULL" }
      ],
      "readback": "Vertical speed {value}",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_VS_FPA_VALUE",
        "expect": "{value}",
        "tolerance": 50
      },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "message": "FCU steht auf TRK/FPA – erst auf HDG/VS umschalten." }
      ],
      "verified": true
    },
    {
      "id": "fcu.loc",
      "area": "FCU",
      "label": "LOC",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_LOC_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_LOC_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "LOC {value}",
      "check": {
        "variable": "L:A32NX_FCU_LOC_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.appr",
      "area": "FCU",
      "label": "Approach",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_APPR_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_APPR_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Approach {value}",
      "check": {
        "variable": "L:A32NX_FCU_APPR_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.exped",
      "area": "FCU",
      "label": "Expedite",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_EXPED_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_EXPED_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Expedite {value}",
      "check": {
        "variable": "L:A32NX_FCU_EXPED_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.ap1",
      "area": "FCU",
      "label": "Autopilot 1",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_AP_1_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_AP_1_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Autopilot one {value}",
      "check": {
        "variable": "L:A32NX_FCU_AP_1_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.ap2",
      "area": "FCU",
      "label": "Autopilot 2",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_AP_2_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_AP_2_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Autopilot two {value}",
      "check": {
        "variable": "L:A32NX_FCU_AP_2_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "fcu.athr",
      "area": "FCU",
      "label": "Autothrust",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_ATHR_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_ATHR_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Autothrust {value}",
      "check": {
        "variable": "L:A32NX_FCU_ATHR_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": true
    },
    {
      "id": "efis.baro",
      "area": "EFIS",
      "label": "QNH",
      "description": "QNH in hPa auf beiden Seiten. Nur im QNH-Modus – aus STD erst efis.baroMode QNH.",
      "parameter": { "min": 900, "max": 1100, "step": 1, "unit": "hPa" },
      "steps": [
        {
          "event": "A32NX.FCU_EFIS_L_BARO_SET",
          "value": "{value}",
          "scale": 16
        },
        {
          "event": "A32NX.FCU_EFIS_R_BARO_SET",
          "value": "{value}",
          "scale": 16
        }
      ],
      "readback": "QNH {value} set",
    "requires": [ { "variable": "L:A32NX_FCU_EFIS_L_DISPLAY_BARO_MODE", "equalTo": 1, "message": "Höhenmesser steht auf STD (oder QFE) – erst efis.baroMode QNH." } ],
      "check": {
        "variable": "L:A32NX_FCU_EFIS_L_DISPLAY_BARO_VALUE",
        "expect": "{value}",
        "tolerance": 0.6
      },
      "verified": false
    },
    {
      "id": "efis.baroMode",
      "area": "EFIS",
      "label": "Baro STD/QNH",
      "parameter": {
        "type": "choice",
        "options": { "STD": 0, "QNH": 1 },
        "spoken": { "STD": "standard" }
      },
      "steps": [
        {
          "event": "A32NX.FCU_EFIS_L_BARO_PULL",
          "only": [ "STD" ],
          "skipIf": { "variable": "L:A32NX_FCU_EFIS_L_DISPLAY_BARO_MODE", "equalTo": 0 }
        },
        {
          "event": "A32NX.FCU_EFIS_R_BARO_PULL",
          "only": [ "STD" ],
          "skipIf": { "variable": "L:A32NX_FCU_EFIS_R_DISPLAY_BARO_MODE", "equalTo": 0 }
        },
        {
          "event": "A32NX.FCU_EFIS_L_BARO_PUSH",
          "only": [ "QNH" ],
          "skipIf": { "variable": "L:A32NX_FCU_EFIS_L_DISPLAY_BARO_MODE", "equalTo": 1 }
        },
        {
          "event": "A32NX.FCU_EFIS_R_BARO_PUSH",
          "only": [ "QNH" ],
          "skipIf": { "variable": "L:A32NX_FCU_EFIS_R_DISPLAY_BARO_MODE", "equalTo": 1 }
        }
      ],
      "readback": "Baro {value}",
      "check": {
        "variable": "L:A32NX_FCU_EFIS_L_DISPLAY_BARO_MODE",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "efis.ls",
      "area": "EFIS",
      "label": "LS",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_EFIS_L_LS_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_EFIS_L_LS_LIGHT_ON",
            "equalTo": "{value}"
          }
        },
        {
          "event": "A32NX.FCU_EFIS_R_LS_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_EFIS_R_LS_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "LS {value}",
      "check": {
        "variable": "L:A32NX_FCU_EFIS_L_LS_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "efis.fd",
      "area": "EFIS",
      "label": "Flight directors",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_EFIS_L_FD_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_EFIS_L_FD_LIGHT_ON",
            "equalTo": "{value}"
          }
        },
        {
          "event": "A32NX.FCU_EFIS_R_FD_PUSH",
          "skipIf": {
