        "0": "", "10": "ALT", "11": "ALT*", "12": "OP CLB", "13": "OP DES", "14": "V/S", "15": "FPA",
        "20": "ALT CST", "21": "ALT CST*", "22": "CLB", "23": "DES", "24": "FINAL", "30": "G/S*", "31": "G/S",
        "32": "LAND", "33": "FLARE", "34": "ROLL OUT", "40": "SRS", "41": "SRS GA", "50": "TCAS"
      }
    },
    "fmaVerticalArmed": {
      "name": "L:A32NX_FMA_VERTICAL_ARMED", "type": "bitmask", "verified": true,
      "values": { "0": "ALT", "1": "ALT CST", "2": "CLB", "3": "DES", "4": "G/S", "5": "FINAL", "6": "TCAS" }
    },
    "fmgcDiscreteWord1": { "name": "L:A32NX_FMGC_1_DISCRETE_WORD_1", "type": "arinc429", "verified": false, "description": "FMGC 1 Discrete Word 1 (für ALT CRZ)" },
    "fmAltitudeConstraint": { "name": "L:A32NX_FMGC_1_FM_ALTITUDE_CONSTRAINT", "type": "arinc429", "verified": false, "description": "Nächste Höhenbeschränkung (ft)" },
