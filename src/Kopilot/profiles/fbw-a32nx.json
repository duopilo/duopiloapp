    "selectedHeading": { "name": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_VALUE", "type": "number", "verified": false, "description": "Anzeige im HDG/TRK-Fenster" },
    "selectedHeadingDashes": { "name": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_DASHES", "type": "bool", "verified": false, "description": "HDG-Fenster zeigt Striche (managed)" },
    "vls": { "name": "L:A32NX_SPEEDS_VLS", "type": "number", "verified": true },
    "v1": { "name": "L:AIRLINER_V1_SPEED", "unit": "knots", "type": "number", "verified": false, "description": "V1 aus der MCDU (intern m/s)" },
    "vr": { "name": "L:AIRLINER_VR_SPEED", "unit": "knots", "type": "number", "verified": false },
    "v2": { "name": "L:AIRLINER_V2_SPEED", "unit": "knots", "type": "number", "verified": false },
    "flexTemp": { "name": "L:A32NX_AIRLINER_TO_FLEX_TEMP", "type": "number", "verified": false, "description": "FLEX-Temperatur (°C) aus der MCDU" },
    "tdReached": { "name": "L:A32NX_PFD_MSG_TD_REACHED", "type": "bool", "verified": false, "description": "PFD-Meldung T/D REACHED" },
    "fmsToWptDistance": { "name": "L:A32NX_EFIS_L_TO_WPT_DISTANCE", "type": "number", "verified": false, "description": "Distanz zum aktiven FMS-Wegpunkt (nm)" },
    "fmsToWptBearing": { "name": "L:A32NX_EFIS_L_TO_WPT_BEARING", "type": "number", "verified": false, "description": "Peilung zum aktiven FMS-Wegpunkt (°)" },
    "fuelFlowKgh": { "name": "L:A32NX_ENGINE_FF:{i}", "type": "number", "verified": true, "description": "Fuel Flow je Triebwerk in kg/h" },
    "egtC": { "name": "L:A32NX_ENGINE_EGT:{i}", "type": "number", "verified": false, "description": "EGT je Triebwerk in °C" },
    "parkingBrake": { "name": "L:A32NX_PARK_BRAKE_LEVER_POS", "type": "bool", "verified": false },
    "spoilersArmed": { "name": "L:A32NX_SPOILERS_ARMED", "type": "bool", "verified": true, "description": "Ground Spoiler armed (Hebel)" },
    "groundSpoilersOut": { "name": "L:A32NX_SEC_1_GROUND_SPOILER_OUT", "type": "bool", "verified": false, "description": "Ground Spoiler ausgefahren (SEC 1)" },
    "decelLight": { "name": "L:A32NX_AUTOBRAKES_DECEL_LIGHT", "type": "bool", "verified": false, "description": "Autobrake DECEL" },
    "transAlt": { "name": "L:A32NX_FM1_TRANS_ALT", "type": "arinc429", "verified": false, "description": "Transition Altitude am Start (ft)" },
    "transLevel": { "name": "L:A32NX_FM1_TRANS_LVL", "type": "arinc429", "scale": 100, "verified": false, "description": "Transition Level am Ziel (FL → ft)" },
    "decisionHeight": { "name": "L:A32NX_FM1_DECISION_HEIGHT", "type": "arinc429", "verified": false, "description": "DH aus PERF APPR (ft), −1 = keine" },
    "minimumDescentAltitude": { "name": "L:A32NX_FM1_MINIMUM_DESCENT_ALTITUDE", "type": "arinc429", "verified": false, "description": "MDA aus PERF APPR (ft)" },
    "flaps": {
      "name": "L:A32NX_FLAPS_CONF_INDEX", "type": "enum", "verified": false,
      "values": { "0": "0", "1": "1", "2": "1+F", "3": "2", "4": "3", "5": "FULL" }
    }
  },
  "ecam": {
    "format": "fbw-a32nx",
    "leftLines": "L:A32NX_EWD_LOWER_LEFT_LINE_{n}",
    "rightLines": "L:A32NX_EWD_LOWER_RIGHT_LINE_{n}",
    "lines": 7
  },
  "limits": {
    // A320neo – VFE je Klappenstellung (Klartext aus "flaps")
    "vmoKt": 350,
    "vleKt": 280,
    "vloKt": 250,
    "vfeKt": { "1": 230, "1+F": 215, "2": 200, "3": 185, "FULL": 177 },
    "landingFlaps": [ "3", "FULL" ],
    "speedLimitBelowFl100Kt": 250
  },
  "electrical": [
    { "key": "gen1Volt", "name": "L:A32NX_ELEC_ENG_GEN_1_POTENTIAL", "description": "GEN 1 (V)" },
    { "key": "gen1Hz", "name": "L:A32NX_ELEC_ENG_GEN_1_FREQUENCY", "description": "GEN 1 (Hz)" },
    { "key": "gen2Volt", "name": "L:A32NX_ELEC_ENG_GEN_2_POTENTIAL", "description": "GEN 2 (V)" },
    { "key": "gen2Hz", "name": "L:A32NX_ELEC_ENG_GEN_2_FREQUENCY", "description": "GEN 2 (Hz)" },
    { "key": "apuGenVolt", "name": "L:A32NX_ELEC_APU_GEN_1_POTENTIAL", "description": "APU GEN (V)" },
    { "key": "extPwrVolt", "name": "L:A32NX_ELEC_EXT_PWR_POTENTIAL", "description": "EXT PWR (V)" },
    { "key": "bat1Volt", "name": "L:A32NX_ELEC_BAT_1_POTENTIAL", "description": "BAT 1 (V)" },
    { "key": "bat2Volt", "name": "L:A32NX_ELEC_BAT_2_POTENTIAL", "description": "BAT 2 (V)" },
    { "key": "ac1Powered", "name": "L:A32NX_ELEC_AC_1_BUS_IS_POWERED", "description": "AC BUS 1", "values": { "0": "aus", "1": "versorgt" } },
    { "key": "ac2Powered", "name": "L:A32NX_ELEC_AC_2_BUS_IS_POWERED", "description": "AC BUS 2", "values": { "0": "aus", "1": "versorgt" } },
    { "key": "acEssPowered", "name": "L:A32NX_ELEC_AC_ESS_BUS_IS_POWERED", "description": "AC ESS BUS", "values": { "0": "aus", "1": "versorgt" } },
    { "key": "dc1Powered", "name": "L:A32NX_ELEC_DC_1_BUS_IS_POWERED", "description": "DC BUS 1", "values": { "0": "aus", "1": "versorgt" } },
    { "key": "dc2Powered", "name": "L:A32NX_ELEC_DC_2_BUS_IS_POWERED", "description": "DC BUS 2", "values": { "0": "aus", "1": "versorgt" } },
    { "key": "dcEssPowered", "name": "L:A32NX_ELEC_DC_ESS_BUS_IS_POWERED", "description": "DC ESS BUS", "values": { "0": "aus", "1": "versorgt" } },
    { "key": "dcBatPowered", "name": "L:A32NX_ELEC_DC_BAT_BUS_IS_POWERED", "description": "DC BAT BUS", "values": { "0": "aus", "1": "versorgt" } }
  ],
  "variables": [
    { "key": "fireButtonEng1", "name": "L:A32NX_FIRE_BUTTON_ENG1", "unit": "number", "description": "ENG 1 Fire Pushbutton (1 = released)", "values": { "0": "IN", "1": "RELEASED" } },
    { "key": "fireGuardEng1", "name": "L:A32NX_FIRE_GUARD_ENG1", "unit": "number", "description": "ENG 1 Fire Guard" },
    { "key": "wingAntiIcePressed", "name": "L:XMLVAR_MOMENTARY_PUSH_OVHD_ANTIICE_WING_PRESSED", "unit": "number", "description": "Wing Anti-Ice Pushbutton" },
    { "key": "vapp", "name": "L:A32NX_SPEEDS_VAPP", "unit": "number", "description": "VAPP aus dem FMS (kt)" },
    { "key": "greenDot", "name": "L:A32NX_SPEEDS_GD", "unit": "number", "description": "Green Dot (kt)" },
    { "key": "fmgcPhase", "name": "L:A32NX_FMGC_FLIGHT_PHASE", "unit": "number", "description": "FMGC-Flugphase",
      "values": { "0": "PREFLIGHT", "1": "TAKEOFF", "2": "CLIMB", "3": "CRUISE", "4": "DESCENT", "5": "APPROACH", "6": "GO AROUND", "7": "DONE" } }
  ],
  // Eingaben (Eingabe-Modul, v0.7): nur diese Aktionen kann Kopilot im Cockpit bedienen – nach Readback und Bestätigung.
  // Quellen: fbw-a32nx/docs/a320-events.md, a320-simvars.md, aircraft_preset_procedures.xml (FBW-Presets), Rust-Systeme.
  // "verified": false = laut FBW-Quellcode, im Sim noch nicht geprüft. Triebwerk, Feuer, Treibstoff und MCDU sind im Code gesperrt.
  "actions": [
    {
      "id": "fcu.speed",
      "area": "FCU",
      "label": "FCU speed",
      "description": "Setzt die Speed (kt) und zieht den Knopf (selected). Im Mach-Modus wird vorher auf Knoten umgeschaltet.",
      "parameter": { "min": 100, "max": 399, "step": 1, "unit": "kt" },
      "steps": [
        {
          "event": "A32NX.FCU_SPD_MACH_TOGGLE_PUSH",
          "skipIf": { "variable": "L:A32NX_FCU_AFS_DISPLAY_MACH_MODE", "equalTo": 0 },
          "delayMs": 150
        },
        {
          "event": "A32NX.FCU_SPD_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_SPD_PULL" }
      ],
      "readback": "Speed {value} selected",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_VALUE",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.speedManaged",
      "area": "FCU",
      "label": "Managed speed",
      "steps": [
        { "event": "A32NX.FCU_SPD_PUSH" }
      ],
      "readback": "Managed speed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_SPD_MACH_MANAGED", "expect": 1 },
      "verified": false
    },
    {
      "id": "fcu.heading",
      "area": "FCU",
      "label": "FCU heading",
      "parameter": { "min": 0, "max": 360, "step": 1, "unit": "°" },
      "steps": [
        {
          "event": "A32NX.FCU_HDG_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_HDG_PULL" }
      ],
      "readback": "Heading {value} selected",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_VALUE",
        "expect": "{value}"
      },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "message": "FCU steht auf TRK/FPA – erst auf HDG/VS umschalten." }
      ],
      "verified": false
    },
    {
      "id": "fcu.headingManaged",
      "area": "FCU",
      "label": "Managed NAV",
      "steps": [
        { "event": "A32NX.FCU_HDG_PUSH" }
      ],
      "readback": "Heading managed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_HDG_TRK_MANAGED", "expect": 1 },
      "verified": false
    },
    {
      "id": "fcu.altitude",
      "area": "FCU",
      "label": "FCU altitude",
      "description": "Stellt nur die Höhe am FCU ein – für Steig-/Sinkflug danach fcu.altitudePull oder fcu.altitudePush.",
      "parameter": { "min": 100, "max": 49000, "step": 100, "unit": "ft", "format": "altitude" },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude {value} set",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_ALT_VALUE",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.altitudePull",
      "area": "FCU",
      "label": "Altitude pull",
      "steps": [
        { "event": "A32NX.FCU_ALT_PULL" }
      ],
      "readback": "Altitude pull, open climb or descent",
      "verified": false
    },
    {
      "id": "fcu.altitudePush",
      "area": "FCU",
      "label": "Altitude push",
      "steps": [
        { "event": "A32NX.FCU_ALT_PUSH" }
      ],
      "readback": "Altitude push, managed",
      "check": { "variable": "L:A32NX_FCU_AFS_DISPLAY_LVL_CH_MANAGED", "expect": 1 },
      "verified": false
    },
    {
      "id": "fcu.altIncrement",
      "area": "FCU",
      "label": "Altitude increment",
      "parameter": {
        "type": "choice",
        "options": { "100": 100, "1000": 1000 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_ALT_INCREMENT_SET",
          "value": "{value}"
        }
      ],
      "readback": "Altitude increment {value}",
      "check": {
        "variable": "L:A32NX_FCU_ALT_INCREMENT_1000",
        "expect": { "100": 0, "1000": 1 }
      },
      "verified": false
    },
    {
      "id": "fcu.vs",
      "area": "FCU",
      "label": "Vertical speed",
      "parameter": { "min": -6000, "max": 6000, "step": 100, "unit": "ft/min" },
      "steps": [
        {
          "event": "A32NX.FCU_VS_SET",
          "value": "{value}",
          "delayMs": 150
        },
        { "event": "A32NX.FCU_VS_PULL" }
      ],
      "readback": "Vertical speed {value}",
      "check": {
        "variable": "L:A32NX_FCU_AFS_DISPLAY_VS_FPA_VALUE",
        "expect": "{value}",
        "tolerance": 50
      },
      "requires": [
        { "variable": "L:A32NX_FCU_AFS_DISPLAY_TRK_FPA_MODE", "equalTo": 0, "message": "FCU steht auf TRK/FPA – erst auf HDG/VS umschalten." }
      ],
      "verified": false
    },
    {
      "id": "fcu.loc",
      "area": "FCU",
      "label": "LOC",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_LOC_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_LOC_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "LOC {value}",
      "check": {
        "variable": "L:A32NX_FCU_LOC_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.appr",
      "area": "FCU",
      "label": "Approach",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_APPR_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_APPR_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Approach {value}",
      "check": {
        "variable": "L:A32NX_FCU_APPR_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.exped",
      "area": "FCU",
      "label": "Expedite",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_EXPED_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_EXPED_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Expedite {value}",
      "check": {
        "variable": "L:A32NX_FCU_EXPED_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.ap1",
      "area": "FCU",
      "label": "Autopilot 1",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_AP_1_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_AP_1_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Autopilot one {value}",
      "check": {
        "variable": "L:A32NX_FCU_AP_1_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.ap2",
      "area": "FCU",
      "label": "Autopilot 2",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_AP_2_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_AP_2_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Autopilot two {value}",
      "check": {
        "variable": "L:A32NX_FCU_AP_2_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "fcu.athr",
      "area": "FCU",
      "label": "Autothrust",
      "parameter": {
        "type": "choice",
        "options": { "on": 1, "off": 0 }
      },
      "steps": [
        {
          "event": "A32NX.FCU_ATHR_PUSH",
          "skipIf": {
            "variable": "L:A32NX_FCU_ATHR_LIGHT_ON",
            "equalTo": "{value}"
          }
        }
      ],
      "readback": "Autothrust {value}",
      "check": {
        "variable": "L:A32NX_FCU_ATHR_LIGHT_ON",
        "expect": "{value}"
      },
      "verified": false
    },
    {
      "id": "efis.baro",
