{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kopilot": {
    "Transport": "http",
    "ClientName": "Kopilot",
    "ReconnectSeconds": 5,
    "ReadTimeoutMs": 3000,
    "HttpUrl": "http://127.0.0.1:5155",
    "ProfilesDirectory": "profiles",
    "FastIntervalFrames": 4,
    "DataDirectory": "",
    "SimBrief": {
      "Username": "",
      "PilotId": "",
      "CacheMinutes": 10
    },
    "Monitoring": {
      "Enabled": true,
      "IntervalMs": 200,
      "DisabledRules": [],
      "HistorySize": 500,
      "AircraftAutoCallouts": false,
      "Traffic": {
        "ProximityRangeNm": 3,
        "ProximityAltitudeFt": 1000,
        "ProximityCooldownSec": 60,
        "ScanIntervalSec": 3,
        "AltitudeReference": "Pressure"
      }
    },
    "Input": {
      "Enabled": false,
      "ConfirmWindowSeconds": 60
    },
    "Atc": {
      "Enabled": true,
      "TemplatesFile": "atc-templates.json",
      "Speak": true
    },
    "Speech": {
      "Enabled": true,
      "Voice": "",
      "Device": "",
      "Volume": 1.0,
      "Rate": 1.1,
      "MinSeverity": "Info",
      "Engine": "auto",
      "KokoroVoice": "bm_george",
      "KokoroModelPath": "",
      "KokoroThreads": 2
    },
    "Remote": {
      "PublicUrl": "",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 90,
      "StateFile": ""
    }
  }
}
