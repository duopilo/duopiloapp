<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows-Anwendung ohne Konsolenfenster: Kopilot sitzt im Infobereich. Der Schalter "console" öffnet bei Bedarf eine Konsole. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\kopilot.ico</ApplicationIcon>
    <AssemblyName>Kopilot</AssemblyName>
    <RootNamespace>Kopilot</RootNamespace>
    <!-- Nur für lokale Builds (update.cmd). Releases setzen die Version aus dem Tag v… (.github/workflows/release.yml). -->
    <Version>0.9.1</Version>
    <!-- SimConnect.dll ist eine native x64-Bibliothek -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- Kokoro-82M (Apache 2.0) über KokoroSharp (MIT), ONNX Runtime auf der CPU. Wiedergabe über den Windows-Player wie die Windows-Stimmen. -->
    <PackageReference Include="KokoroSharp" Version="0.8.4" GeneratePathProperty="true" />
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <!--
      Sprachschleife (v0.9): Whisper über Whisper.net (MIT, whisper.cpp), CPU-Laufzeit plus Vulkan für die GPU-Option.
      Mikrofon über NAudio (MIT, WinMM). Silero VAD (MIT) läuft über die ONNX Runtime, die KokoroSharp schon mitbringt.
      Modelle lädt Kopilot erst, wenn die Sprachschleife eingeschaltet ist, nach %LOCALAPPDATA%\Kopilot\models.
    -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- Core Audio: volle Gerätenamen und das Windows-Standardmikrofon für Status und Dashboard (Aufnahme selbst bleibt WinMM) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!--
    Kokoro-Stimmen: KokoroSharp kopiert beim Build alle Stimmen (auch Chinesisch usw.) nach bin, aber nicht beim Publish.
    Ins veröffentlichte Programm kommen nur die englischen (a = amerikanisch, b = britisch), ca. 15 MB.
    Das Modell selbst (~310 MB) lädt Kopilot erst, wenn Kokoro gebraucht wird, nach %LOCALAPPDATA%\Kopilot\models.
  -->
  <ItemGroup Condition="'$(PkgKokoroSharp)' != ''">
    <None Include="$(PkgKokoroSharp)\content\voices\a?_*.npy;$(PkgKokoroSharp)\content\voices\b?_*.npy" Link="voices\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Dashboard, Schriften (B612, SIL OFL 1.1) und Symbole stecken in der Kopilot.dll -->
  <ItemGroup>
    <EmbeddedResource Include="Dashboard\dashboard.html" LogicalName="Kopilot.Dashboard.dashboard.html" />
    <EmbeddedResource Include="Dashboard\fonts\*.woff" LogicalName="Kopilot.Dashboard.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\kopilot.ico" LogicalName="Kopilot.Dashboard.favicon.ico" />
    <EmbeddedResource Include="Assets\tray-*.ico" LogicalName="Kopilot.Assets.%(Filename)%(Extension)" />
    <None Update="Dashboard\fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="licenses\B612-OFL.txt" />
  </ItemGroup>

  <!--
    WinForms bringt globale usings für System.Windows.Forms und System.Drawing mit. Die kollidieren mit Namen wie
    Timer oder Binding im übrigen Code – deshalb raus damit, der Tray-Code nutzt Aliase.
  -->
  <Target Name="KopilotRemoveWinFormsUsings" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Windows.Forms" />
      <Using Remove="System.Drawing" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Local.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="atc-templates.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Vorlage – beim ersten Start nach %LOCALAPPDATA%\Kopilot\voice-settings.json kopiert (update.cmd überschreibt die nicht) -->
    <Content Update="voice-settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Lokale Geheimnisse nie mitkopieren, falls die Datei versehentlich im Projektordner liegt -->
    <Content Remove="appsettings.Local.json" />
    <Content Update="profiles\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SimConnect-Referenz. Reihenfolge der Suche:
      1. lib\ im Repo (DLLs manuell hineinkopiert)
      2. Umgebungsvariable MSFS2024_SDK
      3. Standardpfad C:\MSFS 2024 SDK\
    Wird nichts gefunden (oder UseSimConnectStub=true gesetzt), wird gegen einen Stub gebaut.
    Der Stub kompiliert, kann sich aber nicht mit MSFS verbinden – nur für CI.
  -->
  <PropertyGroup>
    <_KopilotRepoLib>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'lib'))</_KopilotRepoLib>
    <_KopilotSdkRoot Condition="'$(MSFS2024_SDK)' != ''">$([MSBuild]::EnsureTrailingSlash('$(MSFS2024_SDK)'))</_KopilotSdkRoot>
    <_KopilotSdkRoot Condition="'$(_KopilotSdkRoot)' == ''">C:\MSFS 2024 SDK\</_KopilotSdkRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseSimConnectStub)' != 'true' and Exists('$(_KopilotRepoLib)Microsoft.FlightSimulator.SimConnect.dll')">
    <SimConnectManagedDll>$(_KopilotRepoLib)Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectNativeDll>$(_KopilotRepoLib)SimConnect.dll</SimConnectNativeDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseSimConnectStub)' != 'true' and '$(SimConnectManagedDll)' == '' and Exists('$(_KopilotSdkRoot)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">
    <SimConnectManagedDll>$(_KopilotSdkRoot)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectNativeDll>$(_KopilotSdkRoot)SimConnect SDK\lib\SimConnect.dll</SimConnectNativeDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(SimConnectManagedDll)' != ''">
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(SimConnectNativeDll)" Link="SimConnect.dll" Condition="Exists('$(SimConnectNativeDll)')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(SimConnectManagedDll)' == ''">
    <ProjectReference Include="..\SimConnectStub\SimConnectStub.csproj" />
  </ItemGroup>

  <Target Name="KopilotSimConnectInfo" BeforeTargets="CoreCompile">
    <Message Importance="high" Condition="'$(SimConnectManagedDll)' != ''" Text="Kopilot: SimConnect aus $(SimConnectManagedDll)" />
    <Warning Condition="'$(SimConnectManagedDll)' == ''" Text="Kopilot: Kein MSFS-2024-SDK gefunden – Build läuft gegen den SimConnect-Stub. So kann sich Kopilot NICHT mit MSFS verbinden. Siehe README, Abschnitt 'SimConnect-SDK'." />
    <Warning Condition="'$(SimConnectManagedDll)' != '' and !Exists('$(SimConnectNativeDll)')" Text="Kopilot: Native SimConnect.dll nicht gefunden unter $(SimConnectNativeDll). Bitte manuell neben Kopilot.exe kopieren." />
  </Target>

</Project>
